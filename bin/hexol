#!/usr/bin/env -S guile -L . -e main -s
!#
;;; bin/hexol — the hexol command-line front-end.
;;;
;;; Subcommands are not hardcoded into the dispatcher: each is an <action> —
;;; a predicate over the invocation, (subcommand full-args) -> bool, plus a
;;; runner that receives the full post-program args — registered in *actions*.
;;; `dispatch` owns only a thin frame (help and the no-match error), then runs
;;; the first action whose predicate fires. `help` is the one verb that stays
;;; in the frame: it lists the others (reading them back off *actions*) and
;;; must work before any inventory loads, so it can't be one of the dispatched
;;; things. Each action is still a view of one computation — the same op record
;;; and the same `resolve` fold:
;;;
;;;   hexol render [-o FMT] [-q Q] [--path P] INVENTORY  resolve + emit (default)
;;;   hexol tree                          INVENTORY   the op tree, indented
;;;   hexol ops                           INVENTORY   top-level ops + source
;;;   hexol explain [-q Q] PATH|HASH      INVENTORY   ops that touched PATH
;;;                                                  (or every path an op changed)
;;;
;;; render formats (-o / --output): sexp (default), json, yaml, terraform, ansible,
;;; plus any name an inventory file registers with `renders-with`.
;;;   sexp / json render the whole resolved state;
;;;   yaml    targets the (kubernetes_resources) manifest stream;
;;;   terraform targets the (terraform_config) subtree (Terraform JSON config);
;;;   ansible targets the (ansible_plays) accumulator (a playbook, as JSON);
;;;   a file-registered name (e.g. sql, ledger) runs that file's own
;;;     (state -> text) adapter — its accumulated domain output.
;;;
;;;   -q / --query K=V,…   seed the resolve with these attributes — the
;;;                  query the engine folds over (e.g. -q dc=alpha,role=web).
;;;                  Default is the empty query. Applies to render + explain.
;;;
;;;   --path a.b.c   render only that subtree (tokens that parse as
;;;                  integers are list indices, e.g. regions.alpha5 or
;;;                  kubernetes_resources.3.spec.replicas).
;;;
;;; When --path is omitted and the resolved state has a top-level
;;; `kubernetes_resources` list, render targets that list — so
;;;   hexol render -o yaml chart.scm
;;; emits the manifest stream a `helm template` would, ready for
;;; `kubectl apply -f -`. Otherwise render targets the whole state.
;;;
;;; Examples:
;;;   hexol render examples/inventory.scm
;;;   hexol render --path regions.alpha5 examples/inventory.scm
;;;   hexol render -o yaml examples/kube-prometheus-stack/chart.scm
;;;   hexol render -o json examples/custom-apps.scm
;;;   hexol tree examples/custom-apps.scm
;;;   hexol explain regions.alpha5.network.cni examples/inventory.scm

(add-to-load-path (dirname (dirname (current-filename))))

;; The CLI only needs the kernel — it reads inventories into ops and folds
;; them; it never authors ops. (The author surface is hx-prefixed now, so it
;; no longer shadows anything, but there's still no reason to import it here.)
(use-modules (hexol kernel)
             (hexol yaml)
             (hexol terraform)
             (hexol secret-tool)
             (cmdb json)
             (srfi srfi-1)
             (srfi srfi-9)
             (ice-9 match)
             (ice-9 pretty-print)
             (ice-9 format))

;; ---------------------------------------------------------------------------
;; shared helpers
;; ---------------------------------------------------------------------------

;; ---------------------------------------------------------------------------
;; color — ANSI styling, gated per-port on a TTY and the NO_COLOR convention
;; ---------------------------------------------------------------------------
;; Coloring is decoration only: it never reaches piped output (the port isn't
;; a terminal then) and honors NO_COLOR. stdout and stderr are gated
;; independently, so `… 2>&1 | less` strips both. The data renders (sexp /
;; json / yaml / terraform / ansible) are left untouched — only the
;; human-facing views (tree / ops / explain / show) and diagnostics paint.

(define no-color? (and (getenv "NO_COLOR") #t))
(define (port-color? port) (and (not no-color?) (isatty? port)))
(define stdout-color? (port-color? (current-output-port)))
(define stderr-color? (port-color? (current-error-port)))

;; Build the ESC byte explicitly: Guile's string \x escape is version-
;; dependent (2.2+ wants a `\xHH;` terminator and consumes it; 3.0 in some
;; builds reads `\x1b` greedily and leaves a stray `;` in the string, which
;; turns ESC[…m into a malformed ESC;[…m that no terminal renders).
(define esc (string (integer->char 27)))
(define (paint on? code s)
  (if on? (string-append esc "[" code "m" s esc "[0m") s))

;; stdout painters (the views)
(define (o-dim s)   (paint stdout-color? "2"  s))
(define (o-bold s)  (paint stdout-color? "1"  s))
(define (o-red s)   (paint stdout-color? "31" s))
(define (o-green s) (paint stdout-color? "32" s))
(define (o-yellow s)  (paint stdout-color? "33" s))
(define (o-cyan s)    (paint stdout-color? "36" s))
(define (o-magenta s) (paint stdout-color? "35" s))
;; stderr painters (diagnostics)
(define (e-dim s)   (paint stderr-color? "2"  s))
(define (e-red s)   (paint stderr-color? "31" s))

;; Tint a tree/ops label by its leading keyword so the views scan at a glance.
;; Keying on the displayed label (rather than the internal op-kind) keeps the
;; palette aligned with what the reader actually sees — `module`, `data`,
;; `terraform`, etc. A bare one-word label is a section/group op and reads as
;; bold; an unrecognized keyword is left unpainted.
(define (label-paint label)
  (let* ((sp   (string-index label #\space))
         (head (if sp (substring label 0 sp) label))
         (code (cond
                 ((string=? head "module")    "36")   ; cyan
                 ((string=? head "resource")  "32")   ; green
                 ((string=? head "terraform") "32")   ; green — raw TF resource
                 ((string=? head "data")      "34")   ; blue
                 ((string=? head "provider")  "35")   ; magenta
                 ((string=? head "set")       "33")   ; yellow
                 ((string=? head "append")    "33")   ; yellow
                 ((string=? head "load")      "35")   ; magenta
                 ((not sp)                    "1")    ; bare group/section op → bold
                 (else #f))))
    (if code (paint stdout-color? code label) label)))

;; A `;;`-prefixed informational line on stdout (the comment-style headers the
;; views print). The format string keeps its own trailing ~%.
(define (note fmt . args)
  (display (o-dim (apply format #f fmt args))))

;; jj-style hash gutter. `show` accepts any unambiguous prefix, so the part of
;; the hash worth typing is its shortest prefix unique among all addressable
;; ops; that prefix is highlighted and the rest of the shown short-hash dimmed.
;; current-uniq holds (hash -> shortest-unique-prefix-length) for the tree
;; being printed; the default treats every hash as already-unique at 1 char.
(define (make-uniq-len hashes)
  (lambda (h)
    (let ((hlen (string-length h)))
      (let loop ((l 1))
        (cond
          ((> l hlen) hlen)
          ((= 1 (count (lambda (o) (string-prefix? (substring h 0 l) o)) hashes)) l)
          (else (loop (+ l 1))))))))

(define current-uniq (make-parameter (lambda (h) 1)))

(define (paint-hash hash)
  (let* ((shown (substring hash 0 (min hash-width (string-length hash))))
         (uniq  ((current-uniq) hash)))
    (if (> uniq (string-length shown))
        ;; not disambiguable within the shown width — nothing to highlight
        (o-dim shown)
        (string-append (paint stdout-color? "35" (substring shown 0 uniq))  ; magenta
                       (o-dim (substring shown uniq))))))

(define (die fmt . args)
  (format (current-error-port) "~a~%" (e-red (apply format #f fmt args)))
  (exit 2))

(define (parse-token s)
  (or (string->number s) (string->symbol s)))

(define (parse-path s)
  (map parse-token (string-split s #\.)))

;; "k=v,k=v" -> ((k . v) …): the query attributes seeded as the initial
;; state, the way `(resolve ops attrs)` is called directly. Values parse
;; like path tokens (numbers stay numbers, everything else is a symbol);
;; an empty string is the empty query.
(define (parse-query s)
  (if (string=? s "")
      '()
      (map (lambda (kv)
             (let ((eq (string-index kv #\=)))
               (unless eq (usage-error "bad --query item ~s (want K=V)" kv))
               (cons (string->symbol (substring kv 0 eq))
                     (parse-token (substring kv (+ eq 1))))))
           (string-split s #\,))))

(define (load-ops inv)
  (unless inv (usage-error "missing INVENTORY file"))
  (unless (file-exists? inv) (die "no such inventory file: ~a" inv))
  (load-inventory-file inv))

;; Like `load-ops`, but also collect any (name . renderer) the file
;; registered via `renders-with` — the optional domain-text adapters
;; (SQL DDL, ledger-cli text) that `render -o NAME` invokes. tree / ops /
;; explain don't need these and use plain `load-ops`.
(define (load-ops+renderers inv)
  (unless inv (usage-error "missing INVENTORY file"))
  (unless (file-exists? inv) (die "no such inventory file: ~a" inv))
  (let ((box (list '())))
    (let ((ops (parameterize ((current-renderers box))
                 (load-inventory-file inv))))
      (values ops (reverse (car box))))))

;; Like `load-ops`, but also collect any (name order proc) the file
;; registered via `applies-with` — the effect adapters `apply` runs. Mirrors
;; `load-ops+renderers`; only `apply` needs these.
(define (load-ops+appliers inv)
  (unless inv (usage-error "missing INVENTORY file"))
  (unless (file-exists? inv) (die "no such inventory file: ~a" inv))
  (let ((box (list '())))
    (let ((ops (parameterize ((current-appliers box))
                 (load-inventory-file inv))))
      (values ops (reverse (car box))))))

(define (usage-error fmt . args)
  (format (current-error-port) "~a~%" (e-red (apply format #f fmt args)))
  (format (current-error-port) "~a~%"
          (e-dim (format #f "usage: hexol <~a> ... INVENTORY  (hexol --help)" (verb-list))))
  (exit 2))

;; ---------------------------------------------------------------------------
;; render
;; ---------------------------------------------------------------------------

;; What to render: an explicit --path always wins. Otherwise the data
;; formats (sexp / json) render the WHOLE resolved state, while the
;; structural formats extract their accumulator — yaml the k8s manifest
;; list, hcl the Terraform resources — since a manifest stream is only
;; meaningful for that sub-list.
(define (render-target fmt state path)
  (cond
    (path (path-get state path))
    ((string=? fmt "terraform") (or (state-get state '(terraform_config)) '()))
    ;; (ansible_plays) is keyed by host; a playbook is the list of its plays.
    ((string=? fmt "ansible")
     (map cdr (or (state-get state '(ansible_plays)) '())))
    ((and (string=? fmt "yaml") (pair? state) (assq 'kubernetes_resources state))
     (state-get state '(kubernetes_resources)))
    (else state)))

;; A sequence of maps (each a k8s resource) prints as a multi-doc stream.
(define (sequence-of-maps? x)
  (and (pair? x) (list? x) (every object-shape? x)))

(define (emit-sexp obj) (pretty-print obj))

;; A whole-state sexp dump (no --path) can be hundreds of lines — the very
;; first thing a newcomer runs. When it's big, nudge toward the drill-down
;; views on stderr (so piped stdout stays clean).
(define (size-hint inv text)
  ;; pretty-print ends with a newline, so the newline count is the line count.
  (let ((lines (1- (length (string-split text #\newline)))))
    (when (> lines 80)
      (format (current-error-port) "~a~%"
              (e-dim (format #f ";; ~a lines — drill in with `--path KEY`, or see the op tree: hexol tree ~a"
                             lines inv))))))

(define (emit-json obj) (display (sexp->json-string obj)) (newline))

(define (emit-yaml obj)
  (if (sequence-of-maps? obj)
      (emit-yaml-stream (current-output-port) obj)
      (emit-yaml-document (current-output-port) obj)))

(define (emit-tf obj)
  (emit-terraform-json (current-output-port) obj))

(define (cmd-render args)
  (let loop ((args args) (fmt "sexp") (path #f) (query '()) (inv #f))
    (match args
      (() (do-render (inventory-or-default "render" inv) fmt path query))
      (((or "-o" "--output") f . rest) (loop rest f path query inv))
      (("--path" p . rest) (loop rest fmt (parse-path p) query inv))
      (((or "-q" "--query") q . rest) (loop rest fmt path (parse-query q) inv))
      ((arg . rest)
       (cond
         ((string-prefix? "--output=" arg)
          (loop rest (substring arg 9) path query inv))
         ((string-prefix? "--path=" arg)
          (loop rest fmt (parse-path (substring arg 7)) query inv))
         ((string-prefix? "--query=" arg)
          (loop rest fmt path (parse-query (substring arg 8)) inv))
         ((string-prefix? "-" arg) (usage-error "render: unknown flag ~a" arg))
         (else (loop rest fmt path query arg)))))))

;; The full format list for error messages: the built-ins plus whatever
;; names this file registered via `renders-with`, joined uniformly.
(define builtin-formats '("sexp" "json" "yaml" "terraform" "ansible"))

(define (format-list renderers)
  (string-join (append builtin-formats (map car renderers)) " | "))

(define (do-render inv fmt path query)
  (call-with-values (lambda () (load-ops+renderers inv))
    (lambda (ops renderers)
      (let ((state (resolve ops query))
            (custom (and (not path) (assoc fmt renderers))))
        (cond
          ;; A file-registered renderer wins for its own name. `--path` is a
          ;; state-subtree selector that only makes sense for the generic
          ;; formats, so it suppresses the custom renderer.
          (custom ((cdr custom) state))
          (else
           (let ((target (render-target fmt state path)))
             (when (and path (not target))
               (die "render: path not found: ~a" path))
             (cond
               ((string=? fmt "sexp")
                (let ((text (call-with-output-string
                              (lambda (p) (pretty-print target p)))))
                  (display text)
                  (unless path (size-hint inv text))))
               ((string=? fmt "json") (emit-json target))
               ((string=? fmt "yaml") (emit-yaml target))
               ((string=? fmt "terraform") (emit-tf target))
               ((string=? fmt "ansible") (emit-json target))  ; a playbook is valid JSON
               (else (usage-error "render: unknown output format ~s (~a)"
                                  fmt (format-list renderers)))))))))))

;; ---------------------------------------------------------------------------
;; apply — run the inventory's registered appliers (effects) against ONE
;; resolved state, in order. `render` makes artifacts; `apply` pushes them.
;; ---------------------------------------------------------------------------
;;
;;   hexol apply [--only NAME[,NAME…]] [--dry-run] [-q K=V,…] INVENTORY
;;
;; Resolve once, run the appliers an inventory registered with `applies-with`
;; in registration order, optionally keep only the named ones, and call each (proc state
;; dry?). No hexol-level prompt — appliers lean on their tool's own gate
;; (`tofu apply` prompts). --dry-run delegates to each tool's native dry-run
;; and is meant to be paired with --only (a whole-pipeline dry-run is
;; incoherent: the k8s dry-run needs the cluster the terraform phase builds).

(define (parse-only s) (string-split s #\,))

(define (cmd-apply args)
  (let loop ((args args) (only #f) (dry? #f) (query '()) (inv #f))
    (match args
      (() (do-apply (inventory-or-default "apply" inv) only dry? query))
      (("--dry-run" . rest) (loop rest only #t query inv))
      (((or "--only" "-o") names . rest) (loop rest (parse-only names) dry? query inv))
      (((or "-q" "--query") q . rest) (loop rest only dry? (parse-query q) inv))
      ((arg . rest)
       (cond
         ((string-prefix? "--only=" arg) (loop rest (parse-only (substring arg 7)) dry? query inv))
         ((string-prefix? "-" arg) (usage-error "apply: unknown flag ~a" arg))
         (else (loop rest only dry? query arg)))))))

(define (do-apply inv only dry? query)
  (call-with-values (lambda () (load-ops+appliers inv))
    (lambda (ops appliers)
      (when (null? appliers)
        (die "apply: ~a registers no appliers (use applies-with in the inventory)" inv))
      ;; Validate every requested name before doing anything irreversible.
      (when only
        (for-each (lambda (name)
                    (unless (assoc name appliers)
                      (die "apply: no applier named ~s (have: ~a)"
                           name (string-join (map car appliers) ", "))))
                  only))
      ;; Default order is registration order: stamp each applier with its
      ;; position, and let an explicit `applies-with` order (when given)
      ;; override that key. A stable sort then preserves registration order
      ;; among appliers that share (or omit) an order.
      (let* ((ordered (map (lambda (a i) (list (car a) (or (cadr a) i) (caddr a)))
                           appliers (iota (length appliers))))
             (chosen  (if only
                          (filter (lambda (a) (member (car a) only)) ordered)
                          ordered))
             (sorted  (stable-sort chosen (lambda (a b) (< (cadr a) (cadr b)))))
             (state   (resolve ops query)))   ; resolve ONCE; all appliers share it
        (for-each
          (lambda (a)
            (format (current-error-port) ";; apply: ~a~a~%"
                    (car a) (if dry? " (dry-run)" ""))
            (force-output (current-error-port))
            ((caddr a) state dry?))
          sorted)))))

;; ---------------------------------------------------------------------------
;; tree — concise op-tree view (walks captured source recursively)
;; ---------------------------------------------------------------------------

(define (children-of form)
  (let ((h (car form)) (tail (cdr form)))
    (cond
      ((eq? h 'when)  (cdr tail))
      ((eq? h 'case)  (concatenate (map cdr (cdr tail))))
      (else '()))))

(define (key-or-path->string k)
  (cond ((symbol? k) (symbol->string k))
        ((list? k)   (string-join (map symbol->string k) "."))
        (else (format #f "~a" k))))

(define (label-from-source form)
  (let ((h (car form)))
    (cond
      ((and (eq? h 'load) (pair? (cdr form)) (string? (cadr form)))
       (string-append "load " (cadr form)))
      ((and (eq? h 'resource) (= (length form) 3))
       (string-append "resource " (cadr form) "/" (caddr form)))
      ((and (eq? h 'set)    (pair? (cdr form)))
       (string-append "set "    (key-or-path->string (cadr form))))
      ((and (eq? h 'append) (pair? (cdr form)))
       (string-append "append " (key-or-path->string (cadr form))))
      (else (symbol->string h)))))

(define (prefix bars last?)
  (string-append
    (string-concatenate (map (lambda (b) (if b "│  " "   ")) bars))
    (if last? "└─ " "├─ ")))

(define (line bars last? label) (string-append (o-dim (prefix bars last?)) label))

(define (printable-source? form) (and (pair? form) (symbol? (car form))))

(define (walk-list items bars walk-item)
  (let ((n (length items)))
    (let loop ((xs items) (i 0))
      (unless (null? xs)
        (walk-item (car xs) bars (= i (- n 1)))
        (loop (cdr xs) (+ i 1))))))

;; Width of the short-hash gutter `tree` prints at the start of each op line.
;; `show` accepts any unambiguous prefix, so this is just the display width.
(define hash-width 8)
(define hash-gutter (make-string (+ hash-width 2) #\space))

;; Target width for the human-facing blob views (`show`'s source s-expression
;; and state-delta values). pretty-print wraps to this minus each view's own
;; left margin, so the emitted lines land at ~line-width columns.
(define line-width 120)

(define (walk-op op bars last?)
  (format #t "~a  ~a~%"
          (paint-hash (op-content-hash op))
          (line bars last? (label-paint (or (op-label op) (symbol->string (op-kind op))))))
  (walk-op-children op (concatenate (list bars (list (not last?))))))

(define (walk-source form bars last?)
  ;; Source-derived children have no op record (hence no addressable hash);
  ;; pad the hash gutter so the tree stays aligned.
  (when (printable-source? form)
    (format #t "~a~a~%" hash-gutter
            (line bars last? (label-paint (label-from-source form))))
    (walk-children form (concatenate (list bars (list (not last?)))))))

(define (walk-op-children op bars)
  (let ((children (op-children op)))
    (cond
      ((not (null? children))
       (walk-list children bars walk-op))
      ((and (pair? (op-source op)) (eq? (car (op-source op)) 'load)
            (pair? (cdr (op-source op))) (string? (cadr (op-source op))))
       (walk-list (load-inventory-file (cadr (op-source op))) bars walk-op))
      (else
       (walk-list (filter printable-source? (children-of (op-source op)))
                  bars walk-source)))))

(define (walk-children form bars)
  (cond
    ((and (pair? form) (eq? (car form) 'load)
          (pair? (cdr form)) (string? (cadr form)))
     (walk-list (load-inventory-file (cadr form)) bars walk-op))
    (else
     (walk-list (filter printable-source? (children-of form))
                bars walk-source))))

(define (cmd-tree args)
  (let ((inv (single-positional "tree" args)))
    (let ((ops (load-ops inv)))
      (parameterize ((current-uniq (make-uniq-len (map op-content-hash (tree-op-list ops)))))
        (note ";; inventory: ~a (~a top-level ops)~%" inv (length ops))
        (walk-list ops '() walk-op)))))

;; ---------------------------------------------------------------------------
;; ops — top-level ops with their captured source form
;; ---------------------------------------------------------------------------

(define (cmd-ops args)
  (let ((inv (single-positional "ops" args)))
    (let ((ops (load-ops inv)))
      (note ";; inventory: ~a~%" inv)
      (note ";; ~a top-level ops~%" (length ops))
      (note ";; ----~%")
      (let loop ((ops ops) (i 1))
        (unless (null? ops)
          (let ((op (car ops)))
            (format #t "~3d. ~a~30t~a~%     " i (op-kind op)
                    (o-dim (loc->string (op-loc op))))
            (pretty-print (op-source op))
            (loop (cdr ops) (+ i 1))))))))

;; ---------------------------------------------------------------------------
;; explain — every op that changed a path during the fold
;; ---------------------------------------------------------------------------

(define (leaf? op) (null? (op-children op)))
(define (op-display op) (or (op-label op) (symbol->string (op-kind op))))

;; (file . line) -> "file:line", or a hint when unknown.
(define (loc->string loc)
  (if (pair? loc)
      (format #f "~a:~a" (car loc) (cdr loc))
      "unknown (no source info)"))

(define (trace-hits trace path initial)
  (let loop ((prev initial) (steps trace) (i 0) (hits '()))
    (cond
      ((null? steps) (reverse hits))
      (else
       (let* ((step  (car steps))
              (op    (car step))
              (after (cdr step))
              (pv    (path-get prev path))
              (av    (path-get after path)))
         (loop after (cdr steps) (+ i 1)
               (if (and (leaf? op) (not (equal? pv av)))
                   (cons (list (cons 'step i) (cons 'op op)
                               (cons 'before pv) (cons 'after av))
                         hits)
                   hits)))))))

(define (cmd-explain args)
  ;; explain [--query K=V,…] TARGET INVENTORY  — TARGET is the first positional,
  ;; either a state PATH (a.b.c) or an op hash prefix (see do-explain).
  (let loop ((args args) (target #f) (query '()) (inv #f))
    (match args
      (()
       (unless target (usage-error "explain: missing PATH or HASH"))
       (do-explain (inventory-or-default "explain" inv) target query))
      (((or "-q" "--query") q . rest) (loop rest target (parse-query q) inv))
      ((arg . rest)
       (cond ((string-prefix? "--query=" arg)
              (loop rest target (parse-query (substring arg 8)) inv))
             ((string-prefix? "-" arg) (usage-error "explain: unknown flag ~a" arg))
             ((not target) (loop rest arg query inv))
             ((not inv)    (loop rest target query arg))
             (else (usage-error "explain: unexpected argument ~a" arg)))))))

;; The state paths OP changed when it fired — the keys of its state delta.
;; Mirrors show-delta's trace walk, but returns the paths instead of printing.
(define (op-changed-paths op trace)
  (let loop ((prev '((attributes))) (steps trace))
    (cond
      ((null? steps) '())
      ((eq? (caar steps) op) (map car (state-diff prev (cdar steps) '())))
      (else (loop (cdar steps) (cdr steps))))))

;; Print the explain trace for one PATH: its final value and every op that
;; changed it during the fold.
(define (explain-path final trace path query)
  (let ((hits (trace-hits trace path (list (cons 'attributes query)))))
    (note ";; path:      ~s~%" path)
    (note ";; final:     ~s~%" (path-get final path))
    (note ";; ~a op(s) touched this path:~%~%" (length hits))
    (for-each
      (lambda (hit)
        (let ((op (assq-ref hit 'op)))
          (format #t "  step ~a: ~a~%"
                  (assq-ref hit 'step) (o-bold (op-display op)))
          (format #t "    at:     ~a~%" (o-dim (loc->string (op-loc op))))
          (format #t "    source: ~a~%" (o-dim (format #f "~s" (op-source op))))
          (format #t "    before: ~a~%" (o-red (format #f "~s" (assq-ref hit 'before))))
          (format #t "    after:  ~a~%~%" (o-green (format #f "~s" (assq-ref hit 'after))))))
      hits)))

;; TARGET is a state PATH or an op hash prefix. A dot-free TARGET that matches
;; an op's content hash is taken as that op (the hash `tree`/`show` print), and
;; explain traces every path that op changed. Otherwise TARGET is parsed as a
;; PATH. A hash prefix wins over a single-segment path of the same spelling;
;; qualify with a `.` (or use the full path) to force path mode.
(define (do-explain inv target query)
  (let* ((ops (load-ops inv))
         (op  (and (not (string-index target #\.))
                   (let ((ms (hash-matches ops target))) (and (pair? ms) (car ms))))))
    (call-with-values (lambda () (resolve-with-trace ops query))
      (lambda (final trace)
        (note ";; inventory: ~a~%" inv)
        (note ";; query:     ~s~%" query)
        (if op
            (let ((paths (op-changed-paths op trace)))
              (note ";; op:        ~a  ~a~%" (op-short-hash op hash-width) (op-display op))
              (note ";; at:        ~a~%" (loc->string (op-loc op)))
              (note ";; ~a path~p this op changed:~%~%" (length paths) (length paths))
              (if (null? paths)
                  (note ";; (this op fired no leaf delta — it's a wrapper; explain its children)~%")
                  (for-each (lambda (path) (explain-path final trace path query)) paths)))
            (explain-path final trace (parse-path target) query))))))

;; ---------------------------------------------------------------------------
;; show — one op by its content hash (the hash `tree` prints)
;; ---------------------------------------------------------------------------

;; Every op record in the tree, depth-first (parents before children), so a
;; hash prefix can be matched against the whole tree, not just the top level.
(define (tree-op-list ops)
  (append-map (lambda (op) (cons op (tree-op-list (op-children op)))) ops))

;; Resolve a hash PREFIX against every op in the tree. Returns the list of
;; matching ops (empty when nothing matches, so callers can fall back to other
;; addressing). Exits with the candidate list when the prefix is ambiguous —
;; i.e. it spans more than one distinct content hash.
(define (hash-matches ops prefix)
  (let* ((all      (tree-op-list ops))
         (matches  (filter (lambda (op) (string-prefix? prefix (op-content-hash op)))
                           all))
         (distinct (delete-duplicates (map op-content-hash matches) string=?)))
    (cond
      ((> (length distinct) 1)
       (format (current-error-port) "~a~%"
               (e-red (format #f "hexol: ambiguous prefix ~s — ~a candidates:"
                              prefix (length distinct))))
       (for-each
         (lambda (h)
           (let ((op (find (lambda (o) (string=? (op-content-hash o) h)) matches)))
             (format (current-error-port) "  ~a  ~a  ~a~%"
                     (e-dim (op-short-hash op hash-width)) (op-display op)
                     (e-dim (format #f "(~a)" (loc->string (op-loc op)))))))
         distinct)
       (exit 2))
      (else matches))))

;; Is X a map-shaped alist (every entry a (symbol . _) pair)? Used to decide
;; whether to recurse into a state node or treat it as a changed leaf.
(define (map-alist? x)
  (and (pair? x) (list? x)
       (every (lambda (e) (and (pair? e) (symbol? (car e)))) x)))

;; Leaf-level diff of two state nodes: a list of (path before after) for every
;; path whose value differs. Recurses through map-shaped alists; anything else
;; (scalars, vectors, plain lists) is compared whole.
(define (state-diff a b path)
  (cond
    ((equal? a b) '())
    ((and (map-alist? a) (map-alist? b))
     (let ((keys (delete-duplicates (append (map car a) (map car b)) eq?)))
       (append-map (lambda (k)
                     (state-diff (assq-ref a k) (assq-ref b k)
                                 (append path (list k))))
                   keys)))
    (else (list (list path a b)))))

;; Walk the fire-order trace to the step where OP fired (by eq? identity) and
;; print the state delta it introduced — `before` is the prior step's
;; after-state. Wrappers (compose/when/case) fire after their children and so
;; show no delta of their own; that's reported rather than left blank.
(define (show-delta op trace)
  (let loop ((prev '((attributes))) (steps trace))
    (cond
      ((null? steps)
       (note ";; state delta: this op did not fire in the resolve~%"))
      ((eq? (caar steps) op)
       (let ((diff (state-diff prev (cdar steps) '())))
         (if (null? diff)
             (note ";; state delta: none (wrapper/composite — see children)~%")
             (begin
               (note ";; state delta (~a path~p):~%" (length diff) (length diff))
               (for-each
                 (lambda (d)
                   (format #t "~a~%~a~%~a~%"
                           (o-dim (format #f ";;   ~a" (path->string (car d))))
                           (render-delta-value "-" o-red   (cadr d))
                           (render-delta-value "+" o-green (caddr d))))
                 (if (> (length diff) 40) (take diff 40) diff))
               (when (> (length diff) 40)
                 (note ";;   … and ~a more path(s)~%" (- (length diff) 40)))))))
      (else (loop (cdar steps) (cdr steps))))))

;; ---------------------------------------------------------------------------
;; source blob — `show` prints the op's raw source s-expression. pretty-print
;; lays it out; this adds light syntax tinting and a 2-space indent so the blob
;; sits under the `;; source:` header and scans like the rest of the views.
;; ---------------------------------------------------------------------------

;; Where a bare token ends: the next whitespace, paren/bracket, string quote,
;; or comment. Used to lift one atom out of the pretty-printed text at a time.
(define (token-end s i n)
  (let loop ((j i))
    (if (>= j n)
        j
        (let ((c (string-ref s j)))
          (if (or (char-whitespace? c)
                  (memv c '(#\( #\) #\[ #\] #\" #\;)))
              j
              (loop (+ j 1)))))))

;; Tint one atom. A symbol heading a list (the operator slot) reads as a
;; keyword; numbers, booleans/char/vector literals (#…), and :keywords each
;; get their own hue; everything else is left in the default weight.
(define (tint-atom tok head?)
  (cond
    (head?                          (o-cyan tok))
    ((string->number tok)           (o-yellow tok))
    ((string-prefix? "#" tok)       (o-magenta tok))
    ((string-prefix? ":" tok)       (o-magenta tok))
    (else                           tok)))

;; Colorize pretty-printed Scheme. A flat character scan, string-aware so we
;; never paint inside a "literal" (where parens/semicolons aren't syntax). The
;; token right after an opening paren is the list head; everything else after
;; an open paren is an argument.
(define (highlight-sexp s)
  (if (not stdout-color?)
      s
      (let ((out (open-output-string))
            (n   (string-length s)))
        (let loop ((i 0) (head? #f))
          (if (>= i n)
              (get-output-string out)
              (let ((c (string-ref s i)))
                (cond
                  ;; string literal — consume through the closing quote,
                  ;; honoring backslash escapes.
                  ((char=? c #\")
                   (let scan ((j (+ i 1)))
                     (cond
                       ((>= j n)
                        (display (o-green (substring s i j)) out)
                        (loop j #f))
                       ((char=? (string-ref s j) #\\) (scan (+ j 2)))
                       ((char=? (string-ref s j) #\")
                        (display (o-green (substring s i (+ j 1))) out)
                        (loop (+ j 1) #f))
                       (else (scan (+ j 1))))))
                  ;; comment to end of line
                  ((char=? c #\;)
                   (let ((eol (or (string-index s #\newline i) n)))
                     (display (o-dim (substring s i eol)) out)
                     (loop eol #f)))
                  ;; opening bracket — next atom is the list head
                  ((or (char=? c #\() (char=? c #\[))
                   (write-char c out) (loop (+ i 1) #t))
                  ((or (char=? c #\)) (char=? c #\]))
                   (write-char c out) (loop (+ i 1) #f))
                  ;; whitespace carries the head? flag across (so `(\n  foo`
                  ;; still tints foo as the head)
                  ((char-whitespace? c)
                   (write-char c out) (loop (+ i 1) head?))
                  ;; reader prefixes ' ` , don't consume the head slot
                  ((memv c '(#\' #\` #\,))
                   (write-char c out) (loop (+ i 1) head?))
                  ;; a bare atom
                  (else
                   (let* ((j   (token-end s i n))
                          (tok (substring s i j)))
                     (display (tint-atom tok head?) out)
                     (loop j #f))))))))))

;; Pretty-print DATUM, indent every line two spaces, then tint.
(define (print-source-blob datum)
  (let* ((raw      (call-with-output-string
                     (lambda (p)
                       (pretty-print datum p
                                     #:width (- line-width 2)
                                     #:max-expr-width (- line-width 2)))))
         (indented (string-append
                     "  "
                     (string-join (string-split (string-trim-right raw #\newline)
                                                 #\newline)
                                  "\n  "))))
    (display (highlight-sexp indented))
    (newline)))

;; Render one side of a state-delta entry as `;;` comment lines. A scalar (or
;; any value pretty-print keeps on one line) stays a single `;;     - val`
;; line, as before; a compound value is pretty-printed and each line is
;; comment-prefixed, with the -/+ marker only on the first and continuation
;; lines aligned under it. The whole value is painted in one hue (red/green)
;; so the diff direction stays legible — no per-token tinting here.
(define (render-delta-value marker paint val)
  (let* ((raw   (string-trim-right
                  ;; ";;     - " is a 9-char left margin (`;;` + 5 spaces +
                  ;; marker + space); wrap so the prefixed lines reach line-width.
                  (call-with-output-string
                    (lambda (p)
                      (pretty-print val p
                                    #:width (- line-width 9)
                                    #:max-expr-width (- line-width 9))))
                  #\newline))
         (lines (string-split raw #\newline)))
    (paint
      (string-join
        (map (lambda (ln idx)
               (format #f ";;     ~a ~a" (if (= idx 0) marker " ") ln))
             lines (iota (length lines)))
        "\n"))))

(define (do-show inv prefix)
  (let* ((ops     (load-ops inv))
         (matches (hash-matches ops prefix)))
    (cond
      ((null? matches)
       (die "show: no op matches hash prefix ~s in ~a" prefix inv))
      (else
       (let ((op (car matches)))
         (note ";; inventory: ~a~%" inv)
         (note ";; hash:      ~a~%" (op-content-hash op))
         (when (> (length matches) 1)
           (note ";; note:      ~a ops share this content hash (identical structure)~%"
                 (length matches)))
         (note ";; kind:      ~a~%" (op-kind op))
         (note ";; label:     ~a~%" (op-display op))
         (note ";; location~p: ~a~%" (length matches)
               (string-join (map (lambda (o) (loc->string (op-loc o))) matches) ", "))
         (let ((kids (op-children op)))
           (unless (null? kids)
             (note ";; children (~a):~%" (length kids))
             (for-each (lambda (k)
                         (note ";;   ~a  ~a~%"
                               (op-short-hash k hash-width) (op-display k)))
                       kids)))
         (note ";; source:~%")
         (print-source-blob (op-source op))
         (newline)
         (call-with-values (lambda () (resolve-with-trace ops '()))
           (lambda (final trace) (show-delta op trace))))))))

(define (cmd-show args)
  (let ((pos (filter (lambda (a) (not (string-prefix? "-" a))) args)))
    (match pos
      ((hash inv) (do-show inv hash))
      ((hash) (do-show (inventory-or-default "show" #f) hash))
      (() (usage-error "show: missing HASH and INVENTORY file"))
      (_  (usage-error "show: want HASH INVENTORY")))))

;; ---------------------------------------------------------------------------
;; secret — manage the inline (secrets-store …) in an inventory
;; ---------------------------------------------------------------------------
;;
;; Every verb takes the INVENTORY file as its last positional; the mutating
;; ones rewrite only the store form's span in place. Plaintext only ever
;; reaches stdout (`get`) or $EDITOR (`edit`), never the file or a log.

(define secret-usage "\
usage:
  hexol secret ls                 INVENTORY
  hexol secret get  KEY           INVENTORY
  hexol secret set  KEY [VALUE]   INVENTORY   (VALUE omitted → read stdin)
  hexol secret edit KEY           INVENTORY   ($EDITOR round-trip)
  hexol secret rm   KEY           INVENTORY
  hexol secret rekey              INVENTORY
  hexol secret init               INVENTORY")

(define (secret-error fmt . args)
  (format (current-error-port) "~a~%" (e-red (apply format #f fmt args)))
  (format (current-error-port) "~a~%" (e-dim secret-usage))
  (exit 2))

;; Pull the positionals out of ARGS (no flags in this command family yet),
;; expecting exactly N of them; the inventory is always the last.
(define (secret-positionals verb n args)
  (let ((pos (filter (lambda (a) (not (string-prefix? "-" a))) args)))
    (unless (= (length pos) n)
      (secret-error "secret ~a: expected ~a argument~p, got ~a"
                    verb n n (length pos)))
    pos))

(define (cmd-secret args)
  (match args
    (() (display secret-usage) (newline) (exit 0))
    (((or "-h" "--help") . _) (display secret-usage) (newline) (exit 0))
    (("ls" . rest)
     (match (secret-positionals "ls" 1 rest) ((inv) (secret-ls inv))))
    (("get" . rest)
     (match (secret-positionals "get" 2 rest)
       ((key inv) (secret-get inv (string->symbol key)))))
    (("set" . rest)
     ;; set KEY VALUE INVENTORY  (3 positionals), or set KEY INVENTORY (2 →
     ;; read the value from stdin).
     (let ((pos (filter (lambda (a) (not (string-prefix? "-" a))) rest)))
       (match pos
         ((key value inv) (secret-set inv (string->symbol key) value))
         ((key inv)       (secret-set inv (string->symbol key) #f))
         (_ (secret-error "secret set: want KEY [VALUE] INVENTORY")))))
    (("edit" . rest)
     (match (secret-positionals "edit" 2 rest)
       ((key inv) (secret-edit inv (string->symbol key)))))
    (("rm" . rest)
     (match (secret-positionals "rm" 2 rest)
       ((key inv) (secret-rm inv (string->symbol key)))))
    (("rekey" . rest)
     (match (secret-positionals "rekey" 1 rest) ((inv) (secret-rekey inv))))
    (("init" . rest)
     (match (secret-positionals "init" 1 rest) ((inv) (secret-init inv))))
    ((verb . _) (secret-error "secret: unknown verb ~a" verb))))

;; ---------------------------------------------------------------------------
;; actions — the verb registry
;; ---------------------------------------------------------------------------
;;
;; A subcommand is no longer a hardcoded arm of `dispatch`. It is an <action>:
;; a NAME, a PREDICATE over the invocation — (subcommand full-args) -> bool —
;; and a RUNNER that receives the full post-program args (the verb included)
;; and does the work. `dispatch` walks *actions* and runs the first whose
;; predicate fires, so a new verb is one `register-action!` away with nothing
;; in the dispatcher to touch.
;;
;; The predicate sees the full args, not just the verb, so a future action can
;; fire on a flag or an inventory shape rather than an exact name; the runner
;; likewise gets every argument and slices off what it needs. The built-in
;; verbs all just match their own name (`cmd-is`) and delegate to the existing
;; cmd-* handler. `help` deliberately stays OUT of this set — it lists the
;; verbs by reading them back off *actions* and must work before any inventory
;; loads, so it lives in the dispatch frame instead.

(define-record-type <action>
  (make-action name predicate runner synopsis)
  action?
  (name      action-name)
  (predicate action-predicate)   ; (subcommand full-args) -> bool
  (runner    action-runner)      ; (full-args) -> effects  (full-args includes the verb)
  (synopsis  action-synopsis))   ; one-line usage shown in `hexol --help`

(define *actions* '())

(define (register-action! a)
  (set! *actions* (append *actions* (list a))))

;; The common predicate: fire when the leading subcommand is exactly NAME.
(define (cmd-is name)
  (lambda (subcmd args) (and subcmd (string=? subcmd name))))

;; The cmd-* handlers want the args *after* the verb; the runner is handed the
;; full list, so drop the head.
(define (delegating-runner cmd) (lambda (args) (cmd (cdr args))))

(register-action!
 (make-action "render" (cmd-is "render") (delegating-runner cmd-render)
   "render [-o sexp|json|yaml|terraform|ansible] [-q K=V,…] [--path a.b.c] INVENTORY"))
(register-action!
 (make-action "apply" (cmd-is "apply") (delegating-runner cmd-apply)
   "apply  [--only NAME[,NAME…]] [--dry-run] [-q K=V,…] INVENTORY"))
(register-action!
 (make-action "tree" (cmd-is "tree") (delegating-runner cmd-tree)
   "tree    INVENTORY"))
(register-action!
 (make-action "ops" (cmd-is "ops") (delegating-runner cmd-ops)
   "ops     INVENTORY"))
(register-action!
 (make-action "explain" (cmd-is "explain") (delegating-runner cmd-explain)
   "explain [-q K=V,…] PATH|HASH INVENTORY"))
(register-action!
 (make-action "show" (cmd-is "show") (delegating-runner cmd-show)
   "show    HASH INVENTORY"))
(register-action!
 (make-action "secret" (cmd-is "secret") (delegating-runner cmd-secret)
   "secret  <ls|get|set|edit|rm|rekey|init> … INVENTORY"))

;; A "|"-joined verb list for terse usage lines.
(define (verb-list) (string-join (map action-name *actions*) "|"))

;; ---------------------------------------------------------------------------
;; dispatch — the frame: help, then run the first matching action
;; ---------------------------------------------------------------------------

;; The inventory is invariant across an exploration session but is every
;; subcommand's last positional — exactly the token you must cursor back past
;; to edit the leading HASH/PATH you're actually iterating on. Let $HEXOL_INVENTORY
;; stand in when the positional is omitted, so the iterated token lands last
;; and an up-arrow + edit-last is enough.
(define (inventory-or-default cmd inv)
  (or inv
      (and=> (getenv "HEXOL_INVENTORY")
             (lambda (v) (and (not (string-null? v)) v)))
      (usage-error "~a: missing INVENTORY file (or set $HEXOL_INVENTORY)" cmd)))

(define (single-positional cmd args)
  ;; Subcommands that take exactly one positional (the inventory file), which
  ;; may be supplied via $HEXOL_INVENTORY instead.
  (let ((files (filter (lambda (a) (not (string-prefix? "-" a))) args)))
    (match files
      ((inv) inv)
      (() (inventory-or-default cmd #f))
      (_  (usage-error "~a: expected one INVENTORY file, got ~a" cmd (length files))))))

;; The prose tail of `hexol --help`; the verb synopses above it are generated
;; from *actions* so the help can never drift from the registered set.
(define usage-footer "\
sexp (default) and json render the whole resolved state. -o yaml targets the
(kubernetes_resources) list (a `helm template` equivalent); -o tf targets the
(terraform_config) subtree (Terraform JSON config, a `terraform init`-ready
*.tf.json file); -o ansible targets the (ansible_plays) accumulator (an Ansible
playbook, emitted as JSON). -o NAME runs a renderer the inventory registered via
`renders-with` (e.g. -o sql / -o ledger emit that file's domain text). --path
overrides the target. -q/--query seeds the resolve with attributes (the query
the engine folds over), e.g. -q dc=alpha,role=web.

apply runs the effect adapters an inventory registers with `applies-with`
(e.g. tofu apply, kubectl apply), in their registered order, against one
resolved state. --only NAME[,NAME…] runs just those; --dry-run delegates to
each tool's native dry-run (pair it with --only). Appliers prompt via their
own tool; there is no separate hexol confirmation.

tree prints a stable content hash beside each op; `show HASH` resolves any
unambiguous prefix of one to that op's kind, label, source, location(s),
children, and the state delta it introduced during the resolve.

INVENTORY may be omitted on any subcommand when $HEXOL_INVENTORY names it —
so an exploration loop is just `show HASH` / `explain PATH` with the iterated
token last (up-arrow, edit the last token, re-run).")

(define (show-help)
  (display "hexol — resolve a hexol inventory and view it.\n\nusage:\n")
  (for-each (lambda (a) (format #t "  hexol ~a~%" (action-synopsis a))) *actions*)
  (newline)
  (display usage-footer)
  (newline))

(define (dispatch args)
  (match (cdr args)
    (() (show-help) (exit 0))
    (((or "-h" "--help" "help")) (show-help) (exit 0))
    ((subcmd . _)
     (let* ((rest (cdr args))
            (act  (find (lambda (a) ((action-predicate a) subcmd rest)) *actions*)))
       (if act
           ((action-runner act) rest)
           (usage-error "unknown subcommand: ~a" subcmd))))))

;; Turn a raised error into one clean stderr line instead of a Guile
;; backtrace — the common case being a typo or a mistake inside the
;; inventory the user is editing. Most Guile errors arrive as
;; (subr message message-args . _); we print the filled-in message.
;; Set HEXOL_DEBUG=1 to bypass this and get the full backtrace.
(define (report-error key args)
  (match args
    ;; The standard (scm-error) shape: (subr message message-args . _),
    ;; where subr may be #f. Fill the ~S/~A holes in the message.
    ((subr (? string? msg) margs . _)
     (format (current-error-port) "~a" (e-red "hexol: "))
     (when subr (format (current-error-port) "~a" (e-red (format #f "~a: " subr))))
     (format (current-error-port) "~a~%"
             (e-red (apply format #f msg (or margs '())))))
    (_ (format (current-error-port) "~a~%"
               (e-red (format #f "hexol: ~a: ~s" key args))))))

(define (main args)
  (if (getenv "HEXOL_DEBUG")
      (dispatch args)
      (catch #t
        (lambda () (dispatch args))
        ;; `exit` (from die / usage-error) raises 'quit — let it through
        ;; with its own status; everything else is an unexpected error.
        (lambda (key . rest)
          (if (eq? key 'quit)
              (apply exit rest)
              (begin (report-error key rest) (exit 1)))))))
