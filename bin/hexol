#!/usr/bin/env -S guile -L . -e main -s
!#
;;; bin/hexol — the hexol command-line front-end.
;;;
;;; Subcommands aren't hardcoded: each is an <action> — a predicate
;;; (subcommand full-args) -> bool plus a runner over the full post-program
;;; args — registered in *actions*. `dispatch` is a thin frame (help + no-match
;;; error), then runs the first action whose predicate fires. `help` stays in
;;; the frame: it lists the others off *actions* and must work before any
;;; inventory loads. Each action is a view of one computation — same op record,
;;; same `resolve` fold:
;;;
;;;   hexol render [-o FMT] [--path P]    [-i INV]   resolve + emit (default)
;;;                [--validate]                      (yaml: pipe to kubeconform)
;;;   hexol apply [--only SPEC] [--dry-run] [-i INV] run the appliers (plan)
;;;   hexol diff [--only SPEC] [--explain] [-i INV]  drift: 0 clean, 1 drift, 2 error
;;;   hexol tree [-v]                     [-i INV]   op tree, indented
;;;                                                  (-v: + per-op fold time)
;;;   hexol explain PATH|HASH             [-i INV]   ops that touched PATH
;;;                                                  (or every path an op changed)
;;;   hexol lint                          [-i INV]   warn on $ reads that precede
;;;                                                  the write they depend on
;;;   hexol import -f FILE [--from FMT]              existing k8s YAML / Terraform
;;;                                                  JSON -> an inventory (stdout)
;;;
;;; Inventory is -i/--inventory (or $HEXOL_INVENTORY), never a positional.
;;; `hexol --version` / `hexol version` prints the release ((hexol version)).
;;;
;;; render formats (-o / --output): sexp (default), json, yaml, terraform, ansible,
;;; plus any name an inventory registers with `renders-with`.
;;;   sexp / json — whole resolved state;
;;;   yaml    — the (kubernetes_resources) manifest stream;
;;;   terraform — the (terraform_config) subtree (Terraform JSON config);
;;;   ansible — the (ansible_plays) accumulator (a playbook, as JSON);
;;;   a file-registered name (e.g. sql, ledger) — that file's own
;;;     (state -> text) adapter.
;;;
;;;   --path a.b.c   render only that subtree (integer-parsing tokens are
;;;                  list indices, e.g. kubernetes_resources.3.spec.replicas).
;;;
;;; With --path omitted and a top-level `kubernetes_resources` list, render
;;; targets that list — so `hexol render -o yaml chart.scm` emits the manifest
;;; stream `helm template` would. Otherwise render targets the whole state.
;;;
;;; Examples:
;;;   hexol render examples/inventory.scm
;;;   hexol render --path regions.alpha5 examples/inventory.scm
;;;   hexol render -o yaml examples/kube-prometheus-stack/chart.scm
;;;   hexol render -o json examples/custom-apps.scm
;;;   hexol tree examples/custom-apps.scm
;;;   hexol explain regions.alpha5.network.cni examples/inventory.scm

(add-to-load-path (dirname (dirname (current-filename))))

;; CLI needs only the kernel — it reads inventories into ops and folds them,
;; never authors ops (so the hx-prefixed author surface isn't imported).
(use-modules (hexol kernel)
             (hexol lint)
             (hexol cache)
             (hexol yaml)
             (hexol terraform)
             (hexol secret-tool)
             (hexol import)
             (hexol json)
             (hexol construct)
             (hexol doc)
             ((hexol apply) #:select (current-diff-explainer))
             ((hexol sh) #:select (which-cmd))
             (ice-9 popen)
             (hexol version)
             (srfi srfi-1)
             (srfi srfi-9)
             (ice-9 match)
             (ice-9 pretty-print)
             (ice-9 format)
             (ice-9 textual-ports))

;; ---------------------------------------------------------------------------
;; shared helpers
;; ---------------------------------------------------------------------------

;; ---------------------------------------------------------------------------
;; color — ANSI styling, gated per-port on a TTY and the NO_COLOR convention
;; ---------------------------------------------------------------------------
;; Decoration only: stays out of piped output and honors NO_COLOR. stdout and
;; stderr gate independently, so `… 2>&1 | less` strips both. Data renders
;; (sexp/json/yaml/terraform/ansible) stay untouched — only the human-facing
;; views (tree/ops/explain/show) and diagnostics paint.

(define no-color? (and (getenv "NO_COLOR") #t))

;; Color mode, set by the global `--color[=WHEN]` flag (parsed in `dispatch`):
;;   auto    (default) paint only on a TTY, honoring NO_COLOR;
;;   always  force on regardless of TTY/NO_COLOR — for `… | less -R` or a log;
;;   never   force off.
;; Bare `--color` (no value) means `always` (GNU optional-arg convention).
(define color-mode 'auto)
(define (port-color? port)
  (case color-mode
    ((always) #t)
    ((never)  #f)
    (else     (and (not no-color?) (isatty? port)))))
;; Derived from `port-color?`. `set-color-mode!` re-derives them once the flag
;; is parsed; painters read them at call time, so updating before any output
;; repaints everything downstream.
(define stdout-color? (port-color? (current-output-port)))
(define stderr-color? (port-color? (current-error-port)))
(define (set-color-mode! mode)
  (set! color-mode mode)
  (set! stdout-color? (port-color? (current-output-port)))
  (set! stderr-color? (port-color? (current-error-port))))

;; Build the ESC byte explicitly: Guile's string \x escape is version-dependent
;; (2.2+ wants/consumes a `\xHH;` terminator; some 3.0 builds read `\x1b`
;; greedily, leaving a stray `;` that makes ESC[…m a malformed ESC;[…m).
(define esc (string (integer->char 27)))
(define (paint on? code s)
  (if on? (string-append esc "[" code "m" s esc "[0m") s))

;; stdout painters (the views)
(define (o-dim s)   (paint stdout-color? "2"  s))
(define (o-bold s)  (paint stdout-color? "1"  s))
(define (o-red s)   (paint stdout-color? "31" s))
(define (o-green s) (paint stdout-color? "32" s))
(define (o-yellow s)  (paint stdout-color? "33" s))
(define (o-cyan s)    (paint stdout-color? "36" s))
(define (o-magenta s) (paint stdout-color? "35" s))
;; stderr painters (diagnostics)
(define (e-dim s)   (paint stderr-color? "2"  s))
(define (e-red s)   (paint stderr-color? "31" s))

;; Tint a tree/ops label by its leading keyword so views scan at a glance.
;; Keying on the displayed label (not the internal op-kind) keeps the palette
;; aligned with what the reader sees. A bare one-word label is a section/group
;; op → bold; an unrecognized keyword is left unpainted.
(define (label-paint label)
  (let* ((sp   (string-index label #\space))
         (head (if sp (substring label 0 sp) label))
         (code (cond
                 ((string=? head "module")    "36")   ; cyan
                 ((string=? head "resource")  "32")   ; green
                 ((string=? head "terraform") "32")   ; green — raw TF resource
                 ((string=? head "data")      "34")   ; blue
                 ((string=? head "provider")  "35")   ; magenta
                 ((string=? head "set")       "33")   ; yellow
                 ((string=? head "append")    "33")   ; yellow
                 ((string=? head "load")      "35")   ; magenta
                 ((not sp)                    "1")    ; bare group/section op → bold
                 (else #f))))
    (if code (paint stdout-color? code label) label)))

;; A `;;`-prefixed info line on stdout (the comment-style view headers). The
;; format string keeps its own trailing ~%.
(define (note fmt . args)
  (display (o-dim (apply format #f fmt args))))

;; jj-style hash gutter. `show` takes any unambiguous prefix, so the part worth
;; typing is the hash's shortest prefix unique among all addressable ops; that
;; prefix is highlighted, the rest of the short-hash dimmed. current-uniq holds
;; (hash -> shortest-unique-prefix-length) for the tree; default: unique at 1.
(define (make-uniq-len hashes)
  (lambda (h)
    (let ((hlen (string-length h)))
      (let loop ((l 1))
        (cond
          ((> l hlen) hlen)
          ((= 1 (count (lambda (o) (string-prefix? (substring h 0 l) o)) hashes)) l)
          (else (loop (+ l 1))))))))

(define current-uniq (make-parameter (lambda (h) 1)))

(define (paint-hash hash)
  (let* ((shown (substring hash 0 (min hash-width (string-length hash))))
         (uniq  ((current-uniq) hash)))
    (if (> uniq (string-length shown))
        ;; not disambiguable within shown width — nothing to highlight
        (o-dim shown)
        (string-append (paint stdout-color? "35" (substring shown 0 uniq))  ; magenta
                       (o-dim (substring shown uniq))))))

(define (die fmt . args)
  (format (current-error-port) "~a~%" (e-red (apply format #f fmt args)))
  (exit 2))

(define (parse-token s)
  (or (string->number s) (string->symbol s)))

(define (parse-path s)
  (map parse-token (string-split s #\.)))

;; Value of a "FLAG=value" arg; prefix length computed, not hand-counted, so it
;; can't drift from the literal. (flag-value "--path=" "--path=a.b") => "a.b"
(define (flag-value prefix arg) (substring arg (string-length prefix)))

(define (load-ops inv)
  (unless inv (usage-error "missing INVENTORY file"))
  (unless (file-exists? inv) (die "no such inventory file: ~a" inv))
  (load-inventory-file inv))

;; `hexol secret` rewrites the inventory *file* (byte-accurate splice), so —
;; unlike `render` — it never evaluates it. But evaluating is exactly what runs
;; the inventory's own key provisioning, e.g.
;;   (setenv "SOPS_AGE_KEY" (fetch-age-key))
;; so without it sops can't find the age/PGP identity to decrypt. Load the
;; inventory first, purely for those side effects, so the same hook that serves
;; `render` serves `secret` too — no separate key protocol. Best-effort: a file
;; that doesn't load cleanly (no ops yet, mid-edit) just falls back to whatever
;; key you've put in the real environment.
(define (prime-inventory-env inv)
  (when (and inv (file-exists? inv))
    (catch #t (lambda () (load-inventory-file inv)) (lambda _ #f))))

;; Like `load-ops`, but also collect what the file registered onto COLLECTOR —
;; a kernel registration collector (current-renderers / -appliers / -actions).
;; Returns (values ops entries) in registration order. tree/explain/show don't
;; collect and use plain `load-ops`.
(define (load-ops+collected collector inv)
  (unless inv (usage-error "missing INVENTORY file"))
  (unless (file-exists? inv) (die "no such inventory file: ~a" inv))
  (collect-from collector (lambda () (load-inventory-file inv))))

(define (usage-error fmt . args)
  (format (current-error-port) "~a~%" (e-red (apply format #f fmt args)))
  (format (current-error-port) "~a~%"
          (e-dim (format #f "usage: hexol <~a> … [-i INVENTORY]  (hexol --help)" (verb-list))))
  (exit 2))

;; ---------------------------------------------------------------------------
;; render
;; ---------------------------------------------------------------------------

;; What to render: explicit --path always wins. Otherwise data formats
;; (sexp/json) render the WHOLE state, while structural formats extract their
;; accumulator — yaml the k8s manifest list, terraform the TF config.
(define (render-target fmt state path)
  (cond
    (path (path-get state path))
    ((string=? fmt "terraform") (or (state-get state '(terraform_config)) '()))
    ;; (ansible_plays) is host-keyed; a playbook is the list of its plays.
    ((string=? fmt "ansible")
     (map cdr (or (state-get state '(ansible_plays)) '())))
    ((and (string=? fmt "yaml") (pair? state) (assq 'kubernetes_resources state))
     (state-get state '(kubernetes_resources)))
    (else state)))

;; A sequence of maps (each a k8s resource) → multi-doc stream.
(define (sequence-of-maps? x)
  (and (pair? x) (list? x) (every object-shape? x)))

(define (emit-sexp obj) (pretty-print obj))

;; A whole-state sexp dump (no --path) can be hundreds of lines. When it's big,
;; nudge toward the drill-down views on stderr (piped stdout stays clean).
(define (size-hint inv text)
  ;; pretty-print ends with a newline, so newline count = line count.
  (let ((lines (1- (length (string-split text #\newline)))))
    (when (> lines 80)
      (format (current-error-port) "~a~%"
              (e-dim (format #f ";; ~a lines — drill in with `--path KEY`, or see the op tree: hexol tree ~a"
                             lines inv))))))

(define (emit-json obj) (display (sexp->json-string obj)) (newline))

(define (emit-yaml obj)
  (if (sequence-of-maps? obj)
      (emit-yaml-stream (current-output-port) obj)
      (emit-yaml-document (current-output-port) obj)))

(define (emit-tf obj)
  (emit-terraform-json (current-output-port) obj))

(define (cmd-render args)
  (call-with-values (lambda () (extract-inventory "render" args))
    (lambda (inv rest)
      (let loop ((args rest) (fmt "sexp") (path #f) (validate? #f))
        (match args
          (()
           (when (and validate? (not (string=? fmt "yaml")))
             (usage-error "render: --validate needs -o yaml (kubeconform checks manifests)"))
           (if validate?
               (validate-render (lambda () (do-render (inventory-or-default "render" inv) fmt path)))
               (do-render (inventory-or-default "render" inv) fmt path)))
          (((or "-o" "--output") f . rest) (loop rest f path validate?))
          (("--path" p . rest) (loop rest fmt (parse-path p) validate?))
          (("--validate" . rest) (loop rest fmt path #t))
          ((arg . rest)
           (cond
             ((string-prefix? "--output=" arg)
              (loop rest (flag-value "--output=" arg) path validate?))
             ((string-prefix? "--path=" arg)
              (loop rest fmt (parse-path (flag-value "--path=" arg)) validate?))
             ((string-prefix? "-" arg) (usage-error "render: unknown flag ~a" arg))
             (else (usage-error "render: unexpected argument ~a (inventory is -i/--inventory)" arg)))))))))

;; `render --validate': run RENDER (which writes the yaml stream to stdout) with
;; stdout captured, echo it, then pipe it to `kubeconform -strict -summary' and
;; exit with its status. kubeconform's report goes to stderr so stdout stays
;; the bare stream (`… --validate | kubectl apply -f -' still works). Without
;; kubeconform on PATH the stream is printed unchecked, with a warning.
(define (validate-render render)
  (let ((yaml (with-output-to-string render))
        (kc   (which-cmd "kubeconform")))
    (display yaml)
    (force-output)
    (cond
      ((not kc)
       (format (current-error-port) "~a~%"
               (e-dim ";; render: kubeconform not on PATH — --validate skipped")))
      (else
       (let* ((port (with-output-to-port (current-error-port)
                      (lambda () (open-pipe* OPEN_WRITE kc "-strict" "-summary"))))
              (_    (display yaml port))
              (code (status:exit-val (close-pipe port))))
         (unless (eqv? code 0) (exit code)))))))

;; Full format list for error messages: built-ins plus `renders-with` names.
(define builtin-formats '("sexp" "json" "yaml" "terraform" "ansible"))

(define (format-list renderers)
  (string-join (append builtin-formats (map renderer-name renderers)) " | "))

(define (do-render inv fmt path)
  (call-with-values (lambda () (load-ops+collected current-renderers inv))
    (lambda (ops renderers)
      (let ((state (resolve ops '()))
            (custom (and (not path)
                         (find (lambda (r) (string=? (renderer-name r) fmt)) renderers))))
        (cond
          ;; A file-registered renderer wins for its own name; `--path` (generic
          ;; formats only) suppresses it.
          (custom ((renderer-proc custom) state))
          (else
           (let ((target (render-target fmt state path)))
             (when (and path (not target))
               (die "render: path not found: ~a" path))
             (cond
               ((string=? fmt "sexp")
                (let ((text (call-with-output-string
                              (lambda (p) (pretty-print target p)))))
                  (display text)
                  (unless path (size-hint inv text))))
               ((string=? fmt "json") (emit-json target))
               ((string=? fmt "yaml") (emit-yaml target))
               ((string=? fmt "terraform") (emit-tf target))
               ((string=? fmt "ansible") (emit-json target))  ; a playbook is valid JSON
               (else (usage-error "render: unknown output format ~s (~a)"
                                  fmt (format-list renderers)))))))))))

;; ---------------------------------------------------------------------------
;; apply — run the inventory's appliers against ONE resolved state, in order.
;; `render` makes artifacts; `apply` pushes them.
;; ---------------------------------------------------------------------------
;;
;;   hexol apply [--only SPEC] [--dry-run] [--list] [-i INVENTORY]
;;   hexol diff  [--only SPEC] [--explain]         [-i INVENTORY]
;;
;; Resolve once, then run the `applies-with` appliers in registration order,
;; each (proc state mode), mode ∈ apply | plan | diff. --list prints that
;; order. --dry-run is mode `plan`: each tool's native dry-run (pair with
;; --only; a whole-pipeline dry-run is incoherent — k8s dry-run needs the
;; cluster terraform builds). No hexol prompt — appliers lean on their tool's
;; gate (`tofu apply` prompts).
;;
;; `diff` is mode `diff`: same pipeline, but each applier reports drift between
;; the rendered state and the world by returning `drift`. Exit 0 clean, 1 drift,
;; 2 error. --explain binds `current-diff-explainer` over the resolve trace, so
;; an applier with a structural diff (kubectl) prints, under each changed path,
;; the op that set it (label + file:line); terraform has no structural path and
;; streams its plan as-is.
;;
;; --only SPEC selects a subset, keeping pipeline order. SPEC is comma-separated
;; terms, each a NAME or a jj-style range: A::B (through), A:: (to end), ::B
;; (from start) — so `--only kubernetes::` resumes a deploy from the k8s step.

(define (cmd-apply args)
  (call-with-values (lambda () (extract-inventory "apply" args))
    (lambda (inv rest)
      (let loop ((args rest) (only #f) (mode 'apply) (list? #f))
        (match args
          (() (do-apply (inventory-or-default "apply" inv) only mode list? #f))
          (("--dry-run" . rest) (loop rest only 'plan list?))
          (("--list" . rest) (loop rest only mode #t))
          (("--only" spec . rest) (loop rest spec mode list?))
          ((arg . rest)
           (cond
             ((string-prefix? "--only=" arg) (loop rest (flag-value "--only=" arg) mode list?))
             ((string-prefix? "-" arg) (usage-error "apply: unknown flag ~a" arg))
             (else (usage-error "apply: unexpected argument ~a (inventory is -i/--inventory)" arg)))))))))

(define (cmd-diff args)
  (call-with-values (lambda () (extract-inventory "diff" args))
    (lambda (inv rest)
      (let loop ((args rest) (only #f) (explain? #f))
        (match args
          (()
           ;; Any error in a diff is exit 2 (1 is reserved for drift), so
           ;; report it here rather than letting `main` turn it into a 1.
           (catch #t
             (lambda () (do-apply (inventory-or-default "diff" inv) only 'diff #f explain?))
             (lambda (key . rest)
               (if (eq? key 'quit)
                   (apply exit rest)
                   (begin (report-error key rest) (exit 2))))))
          (("--explain" . rest) (loop rest only #t))
          (("--only" spec . rest) (loop rest spec explain?))
          ((arg . rest)
           (cond
             ((string-prefix? "--only=" arg) (loop rest (flag-value "--only=" arg) explain?))
             ((string-prefix? "-" arg) (usage-error "diff: unknown flag ~a" arg))
             (else (usage-error "diff: unexpected argument ~a (inventory is -i/--inventory)" arg)))))))))

;; Select a subset of ordered APPLIERS by SPEC (see cmd-apply), in pipeline
;; order; errors on an unknown name or reversed range.
(define (select-appliers appliers spec)
  (let* ((names (map applier-name appliers))
         (last  (1- (length names)))
         (index (lambda (n)
                  (or (list-index (lambda (x) (string=? x n)) names)
                      (die "apply: no applier named ~s (have: ~a)"
                           n (string-join names ", ")))))
         (keep  (make-vector (length names) #f)))
    (define (mark-term t)
      (let* ((sep (string-contains t "::"))
             (lo  (if sep (substring t 0 sep) t))
             (hi  (if sep (substring t (+ sep 2)) t))
             (i   (if (string=? lo "") 0    (index lo)))
             (j   (if (string=? hi "") last (index hi))))
        (when (> i j) (die "apply: reversed range ~s" t))
        (let mark ((k i)) (when (<= k j) (vector-set! keep k #t) (mark (1+ k))))))
    (for-each mark-term (string-split spec #\,))
    (let pick ((as appliers) (i 0) (acc '()))
      (cond ((null? as) (reverse acc))
            ((vector-ref keep i) (pick (cdr as) (1+ i) (cons (car as) acc)))
            (else (pick (cdr as) (1+ i) acc))))))

;; The `--explain` callback: given a state path a diff hunk changed, print the
;; op that last set it — label and file:line — from the resolve TRACE, reusing
;; `trace-hits`. Wrapper ops don't register hits, so this names the leaf.
(define (make-diff-explainer trace)
  (lambda (path)
    (let ((hits (trace-hits trace path '((attributes)))))
      (if (null? hits)
          (format #t "    set by: ~a~%" (o-dim "(no op recorded for this path)"))
          (let ((op (assq-ref (last hits) 'op)))
            (format #t "    set by: ~a  ~a~%"
                    (o-bold (op-display op)) (o-dim (loc->string (op-loc op)))))))))

;; MODE is apply | plan | diff (see the section comment). Under diff, an applier
;; returning `drift` marks the run; exit 1 once every chosen applier has run.
;; EXPLAIN? (diff only) resolves with a trace and binds `current-diff-explainer`.
(define (do-apply inv only mode list? explain?)
  (call-with-values (lambda () (load-ops+collected current-appliers inv))
    (lambda (ops appliers)
      (when (null? appliers)
        (die "~a: ~a registers no appliers (use applies-with in the inventory)"
             (if (eq? mode 'diff) "diff" "apply") inv))
      (cond
        (list?
         (note ";; ~a appliers (pipeline order):~%" (length appliers))
         (for-each (lambda (a) (format #t "  ~a~%" (applier-name a))) appliers))
        (else
         (let ((chosen (if only (select-appliers appliers only) appliers))
               (drift? #f))
           ;; resolve ONCE; appliers share the state (traced only for --explain)
           (call-with-values
             (lambda () (if explain? (resolve-with-trace ops '()) (values (resolve ops '()) #f)))
             (lambda (state trace)
               (parameterize ((current-diff-explainer (and trace (make-diff-explainer trace))))
                 (for-each
                   (lambda (a)
                     (format (current-error-port) ";; ~a: ~a~a~%"
                             (if (eq? mode 'diff) "diff" "apply")
                             (applier-name a) (if (eq? mode 'plan) " (dry-run)" ""))
                     (force-output (current-error-port))
                     (when (eq? 'drift ((applier-proc a) state mode))
                       (set! drift? #t)))
                   chosen))))
           (when (eq? mode 'diff)
             (format (current-error-port) "~a~%"
                     (if drift? (e-red ";; diff: drift detected") (e-dim ";; diff: clean")))
             (exit (if drift? 1 0)))))))))

;; ---------------------------------------------------------------------------
;; tree — concise op-tree view (walks captured source recursively)
;; ---------------------------------------------------------------------------

(define (children-of form)
  (let ((h (car form)) (tail (cdr form)))
    (cond
      ((eq? h 'when)  (cdr tail))
      ((eq? h 'case)  (concatenate (map cdr (cdr tail))))
      (else '()))))

(define (key-or-path->string k)
  (cond ((symbol? k) (symbol->string k))
        ((list? k)   (string-join (map symbol->string k) "."))
        (else (format #f "~a" k))))

(define (label-from-source form)
  (let ((h (car form)))
    (cond
      ((and (eq? h 'load) (pair? (cdr form)) (string? (cadr form)))
       (string-append "load " (cadr form)))
      ((and (eq? h 'resource) (= (length form) 3))
       (string-append "resource " (cadr form) "/" (caddr form)))
      ((and (eq? h 'set)    (pair? (cdr form)))
       (string-append "set "    (key-or-path->string (cadr form))))
      ((and (eq? h 'append) (pair? (cdr form)))
       (string-append "append " (key-or-path->string (cadr form))))
      (else (symbol->string h)))))

(define (prefix bars last?)
  (string-append
    (string-concatenate (map (lambda (b) (if b "│  " "   ")) bars))
    (if last? "└─ " "├─ ")))

(define (line bars last? label) (string-append (o-dim (prefix bars last?)) label))

(define (printable-source? form) (and (pair? form) (symbol? (car form))))

(define (walk-list items bars walk-item)
  (let ((n (length items)))
    (let loop ((xs items) (i 0))
      (unless (null? xs)
        (walk-item (car xs) bars (= i (- n 1)))
        (loop (cdr xs) (+ i 1))))))

;; Width of the short-hash gutter `tree` prints per op line. `show` takes any
;; unambiguous prefix, so this is just the display width.
(define hash-width 8)
(define hash-gutter (make-string (+ hash-width 2) #\space))

;; Target width for the human-facing blob views (`show`'s source s-expression
;; and state-delta values). pretty-print wraps to this minus each view's left
;; margin, so emitted lines land at ~line-width columns.
(define line-width 120)

;; `tree -v` timing column. When bound (verbose), holds the op -> internal-
;; real-time-units hashq table `resolve-with-timings` populated; else #f and the
;; column collapses. 10 chars (right-justified "NN.NNms") + 2-space gap, so op
;; and source lines stay aligned under the hash gutter.
(define tree-timings (make-parameter #f))
(define time-col-width 12)

(define (op-time-ms op)
  ;; OP's measured fold time in ms, or #f if unmeasured (e.g. a `when` whose
  ;; predicate never fired, so its effect never ran).
  (let ((table (tree-timings)))
    (and table
         (let ((u (hashq-ref table op)))
           (and u (/ (* 1000.0 u) internal-time-units-per-second))))))

;; Timing cell for an op line (empty unless verbose).
(define (time-cell op)
  (if (tree-timings)
      (let ((ms (op-time-ms op)))
        (string-append
          (o-dim (format #f "~10@a" (if ms (format #f "~,2fms" ms) "—"))) "  "))
      ""))

;; A blank timing cell for source-derived lines (no op record to measure).
(define (time-blank)
  (if (tree-timings) (make-string time-col-width #\space) ""))

(define (walk-op op bars last?)
  (format #t "~a  ~a~a~%"
          (paint-hash (op-content-hash op))
          (time-cell op)
          (line bars last? (label-paint (or (op-label op) (symbol->string (op-kind op))))))
  (walk-op-children op (concatenate (list bars (list (not last?))))))

(define (walk-source form bars last?)
  ;; Source-derived children have no op record (no addressable hash); pad the
  ;; hash and timing gutters so the tree stays aligned.
  (when (printable-source? form)
    (format #t "~a~a~a~%" hash-gutter (time-blank)
            (line bars last? (label-paint (label-from-source form))))
    (walk-children form (concatenate (list bars (list (not last?)))))))

(define (walk-op-children op bars)
  (let ((children (op-children op)))
    (cond
      ((not (null? children))
       (walk-list children bars walk-op))
      ((and (pair? (op-source op)) (eq? (car (op-source op)) 'load)
            (pair? (cdr (op-source op))) (string? (cadr (op-source op))))
       (walk-list (load-inventory-file (cadr (op-source op))) bars walk-op))
      (else
       (walk-list (filter printable-source? (children-of (op-source op)))
                  bars walk-source)))))

(define (walk-children form bars)
  (cond
    ((and (pair? form) (eq? (car form) 'load)
          (pair? (cdr form)) (string? (cadr form)))
     (walk-list (load-inventory-file (cadr form)) bars walk-op))
    (else
     (walk-list (filter printable-source? (children-of form))
                bars walk-source))))

(define (cmd-tree args)
  (call-with-values (lambda () (extract-verbose args))
    (lambda (verbose? rest)
      (let* ((inv (inventory-only "tree" rest))
             (ops (load-ops inv)))
        (parameterize ((current-uniq (make-uniq-len (map op-content-hash (tree-op-list ops)))))
          (note ";; inventory: ~a (~a top-level ops)~%" inv (length ops))
          (if verbose?
              ;; Fold once to measure each op's time, then annotate the tree.
              ;; Times include children (a parent totals its subtree). Seeded
              ;; with the empty query, like `render`.
              (let ((timings (make-hash-table)))
                (resolve-with-timings ops '() timings)
                (note ";; -v: fold time per op (inclusive of children)~%")
                (parameterize ((tree-timings timings))
                  (walk-list ops '() walk-op)))
              (walk-list ops '() walk-op)))))))

;; ---------------------------------------------------------------------------
;; explain — every op that changed a path during the fold
;; ---------------------------------------------------------------------------

(define (leaf? op) (null? (op-children op)))
(define (op-display op) (or (op-label op) (symbol->string (op-kind op))))

;; (file . line) -> "file:line", or a hint when unknown.
(define (loc->string loc)
  (if (pair? loc)
      (format #f "~a:~a" (car loc) (cdr loc))
      "unknown (no source info)"))

(define (trace-hits trace path initial)
  (let loop ((prev initial) (steps trace) (i 0) (hits '()))
    (cond
      ((null? steps) (reverse hits))
      (else
       (let* ((step  (car steps))
              (op    (car step))
              (after (cdr step))
              (pv    (path-get prev path))
              (av    (path-get after path)))
         (loop after (cdr steps) (+ i 1)
               (if (and (leaf? op) (not (equal? pv av)))
                   (cons (list (cons 'step i) (cons 'op op)
                               (cons 'before pv) (cons 'after av))
                         hits)
                   hits)))))))

(define (cmd-explain args)
  ;; explain TARGET — sole positional, a state PATH (a.b.c) or an op hash
  ;; prefix (see do-explain). Inventory is -i/env.
  (call-with-values (lambda () (extract-inventory "explain" args))
    (lambda (inv rest)
      (let loop ((args rest) (target #f))
        (match args
          (()
           (unless target (usage-error "explain: missing PATH or HASH"))
           (do-explain (inventory-or-default "explain" inv) target))
          ((arg . rest)
           (cond ((string-prefix? "-" arg) (usage-error "explain: unknown flag ~a" arg))
                 ((not target) (loop rest arg))
                 (else (usage-error "explain: unexpected argument ~a (inventory is -i/--inventory)" arg)))))))))

;; The state paths OP changed when it fired — its delta's keys. Mirrors
;; show-delta's trace walk, but returns the paths instead of printing.
(define (op-changed-paths op trace)
  (let loop ((prev '((attributes))) (steps trace))
    (cond
      ((null? steps) '())
      ((eq? (caar steps) op) (map car (state-diff prev (cdar steps) '())))
      (else (loop (cdar steps) (cdr steps))))))

;; Print the explain trace for one PATH: its final value and every op that
;; changed it.
(define (explain-path final trace path)
  (let ((hits (trace-hits trace path '((attributes)))))
    (note ";; path:      ~s~%" path)
    (note ";; final:     ~s~%" (path-get final path))
    (note ";; ~a op(s) touched this path:~%~%" (length hits))
    (for-each
      (lambda (hit)
        (let ((op (assq-ref hit 'op)))
          (format #t "  step ~a: ~a~%"
                  (assq-ref hit 'step) (o-bold (op-display op)))
          (format #t "    at:     ~a~%" (o-dim (loc->string (op-loc op))))
          (format #t "    source: ~a~%" (o-dim (format #f "~s" (op-source op))))
          (format #t "    before: ~a~%" (o-red (format #f "~s" (assq-ref hit 'before))))
          (format #t "    after:  ~a~%~%" (o-green (format #f "~s" (assq-ref hit 'after))))))
      hits)))

;; TARGET is a state PATH or an op hash prefix. A dot-free TARGET matching an
;; op's content hash is taken as that op, tracing every path it changed;
;; otherwise parsed as a PATH. A hash prefix wins over a same-spelled single-
;; segment path; qualify with a `.` (or full path) to force path mode.
(define (do-explain inv target)
  (let* ((ops (load-ops inv))
         (op  (and (not (string-index target #\.))
                   (let ((ms (hash-matches ops target))) (and (pair? ms) (car ms))))))
    (call-with-values (lambda () (resolve-with-trace ops '()))
      (lambda (final trace)
        (note ";; inventory: ~a~%" inv)
        (if op
            (let ((paths (op-changed-paths op trace)))
              (note ";; op:        ~a  ~a~%" (op-short-hash op hash-width) (op-display op))
              (note ";; at:        ~a~%" (loc->string (op-loc op)))
              (note ";; ~a path~p this op changed:~%~%" (length paths) (length paths))
              (if (null? paths)
                  (note ";; (this op fired no leaf delta — it's a wrapper; explain its children)~%")
                  (for-each (lambda (path) (explain-path final trace path)) paths)))
            (explain-path final trace (parse-path target)))))))

;; ---------------------------------------------------------------------------
;; lint — reads that precede the write they depend on (see hexol/lint.scm)
;; ---------------------------------------------------------------------------

(define (cmd-lint args)
  (let* ((inv      (inventory-only "lint" args))
         (warnings (lint-ops (load-ops inv))))
    (for-each (lambda (w) (format (current-error-port) "~a~%" (e-red (string-append "warning: " w))))
              warnings)
    (format (current-error-port) "~a~%"
            (e-dim (format #f "hexol lint: ~a: ~a warning~p" inv (length warnings) (length warnings))))
    (exit (if (null? warnings) 0 1))))

;; ---------------------------------------------------------------------------
;; show — one op by its content hash (the hash `tree` prints)
;; ---------------------------------------------------------------------------

;; Every op in the tree, depth-first (parents before children), so a hash
;; prefix matches the whole tree, not just the top level.
(define (tree-op-list ops)
  (append-map (lambda (op) (cons op (tree-op-list (op-children op)))) ops))

;; Resolve a hash PREFIX against every op in the tree. Returns matching ops
;; (empty when none match, so callers can fall back to other addressing). Exits
;; with the candidate list when the prefix spans >1 distinct content hash.
(define (hash-matches ops prefix)
  (let* ((all      (tree-op-list ops))
         (matches  (filter (lambda (op) (string-prefix? prefix (op-content-hash op)))
                           all))
         (distinct (delete-duplicates (map op-content-hash matches) string=?)))
    (cond
      ((> (length distinct) 1)
       (format (current-error-port) "~a~%"
               (e-red (format #f "hexol: ambiguous prefix ~s — ~a candidates:"
                              prefix (length distinct))))
       (for-each
         (lambda (h)
           (let ((op (find (lambda (o) (string=? (op-content-hash o) h)) matches)))
             (format (current-error-port) "  ~a  ~a  ~a~%"
                     (e-dim (op-short-hash op hash-width)) (op-display op)
                     (e-dim (format #f "(~a)" (loc->string (op-loc op)))))))
         distinct)
       (exit 2))
      (else matches))))

;; Leaf-level diff of two state nodes: (path before after) for every path whose
;; value differs. Recurses through map-shaped alists (via yaml's `object-shape?',
;; sound because resolved state never carries duplicate keys); anything else
;; (scalars, vectors, plain lists) is compared whole.
(define (state-diff a b path)
  (cond
    ((equal? a b) '())
    ((and (object-shape? a) (object-shape? b))
     (let ((keys (delete-duplicates (append (map car a) (map car b)) eq?)))
       (append-map (lambda (k)
                     (state-diff (assq-ref a k) (assq-ref b k)
                                 (append path (list k))))
                   keys)))
    (else (list (list path a b)))))

;; Walk the fire-order trace to where OP fired (by eq?) and print the delta it
;; introduced — `before` is the prior step's after-state. Wrappers
;; (compose/when/case) fire after their children and show no delta; that's
;; reported rather than left blank.
(define (show-delta op trace)
  (let loop ((prev '((attributes))) (steps trace))
    (cond
      ((null? steps)
       (note ";; state delta: this op did not fire in the resolve~%"))
      ((eq? (caar steps) op)
       (let ((diff (state-diff prev (cdar steps) '())))
         (if (null? diff)
             (note ";; state delta: none (wrapper/composite — see children)~%")
             (begin
               (note ";; state delta (~a path~p):~%" (length diff) (length diff))
               (for-each
                 (lambda (d)
                   (format #t "~a~%~a~%~a~%"
                           (o-dim (format #f ";;   ~a" (path->string (car d))))
                           (render-delta-value "-" o-red   (cadr d))
                           (render-delta-value "+" o-green (caddr d))))
                 (if (> (length diff) 40) (take diff 40) diff))
               (when (> (length diff) 40)
                 (note ";;   … and ~a more path(s)~%" (- (length diff) 40)))))))
      (else (loop (cdar steps) (cdr steps))))))

;; ---------------------------------------------------------------------------
;; source blob — `show` prints the op's raw source s-expression. pretty-print
;; lays it out; we add a 2-space indent so the blob sits under the `;; source:`
;; header.
;; ---------------------------------------------------------------------------

;; Pretty-print DATUM, indent every line two spaces.
(define (print-source-blob datum)
  (let* ((raw      (call-with-output-string
                     (lambda (p)
                       (pretty-print datum p
                                     #:width (- line-width 2)
                                     #:max-expr-width (- line-width 2)))))
         (indented (string-append
                     "  "
                     (string-join (string-split (string-trim-right raw #\newline)
                                                 #\newline)
                                  "\n  "))))
    (display indented)
    (newline)))

;; Render one side of a state-delta entry as `;;` comment lines. A one-line
;; value stays a single `;;     - val` line; a compound value is pretty-printed
;; and each line comment-prefixed, with the -/+ marker only on the first and
;; continuations aligned under it. The whole value is painted in one hue
;; (red/green) so the diff direction stays legible — no per-token tinting.
(define (render-delta-value marker paint val)
  (let* ((raw   (string-trim-right
                  ;; ";;     - " is a 9-char left margin (`;;` + 5 spaces +
                  ;; marker + space); wrap so prefixed lines reach line-width.
                  (call-with-output-string
                    (lambda (p)
                      (pretty-print val p
                                    #:width (- line-width 9)
                                    #:max-expr-width (- line-width 9))))
                  #\newline))
         (lines (string-split raw #\newline)))
    (paint
      (string-join
        (map (lambda (ln idx)
               (format #f ";;     ~a ~a" (if (= idx 0) marker " ") ln))
             lines (iota (length lines)))
        "\n"))))

(define (do-show inv prefix)
  (let* ((ops     (load-ops inv))
         (matches (hash-matches ops prefix)))
    (cond
      ((null? matches)
       (die "show: no op matches hash prefix ~s in ~a" prefix inv))
      (else
       (let ((op (car matches)))
         (note ";; inventory: ~a~%" inv)
         (note ";; hash:      ~a~%" (op-content-hash op))
         (when (> (length matches) 1)
           (note ";; note:      ~a ops share this content hash (identical structure)~%"
                 (length matches)))
         (note ";; kind:      ~a~%" (op-kind op))
         (note ";; label:     ~a~%" (op-display op))
         (note ";; location~p: ~a~%" (length matches)
               (string-join (map (lambda (o) (loc->string (op-loc o))) matches) ", "))
         (let ((kids (op-children op)))
           (unless (null? kids)
             (note ";; children (~a):~%" (length kids))
             (for-each (lambda (k)
                         (note ";;   ~a  ~a~%"
                               (op-short-hash k hash-width) (op-display k)))
                       kids)))
         (note ";; source:~%")
         (print-source-blob (op-source op))
         (newline)
         (call-with-values (lambda () (resolve-with-trace ops '()))
           (lambda (final trace) (show-delta op trace))))))))

(define (cmd-show args)
  (call-with-values (lambda () (extract-inventory "show" args))
    (lambda (inv rest)
      (match rest
        ((hash) (if (string-prefix? "-" hash)
                    (usage-error "show: unknown flag ~a" hash)
                    (do-show (inventory-or-default "show" inv) hash)))
        (() (usage-error "show: missing HASH"))
        (_  (usage-error "show: want a single HASH (inventory is -i/--inventory)"))))))

;; ---------------------------------------------------------------------------
;; doc — what `(key value)` entries a define-construct accepts
;; ---------------------------------------------------------------------------
;;
;; Reads the schema registry (hexol construct) fills at definition time, so it
;; documents whatever is *loaded*: with -i (or $HEXOL_INVENTORY) the inventory
;; is loaded for its `use-modules` side effect — its own constructs included;
;; without one, the built-in libraries are.
(define (cmd-doc args)
  (call-with-values (lambda () (extract-inventory "doc" args))
    (lambda (inv rest)
      (let ((inv (or inv (env-inventory))))
        (if inv
            (load-ops inv)
            (for-each resolve-module '((hexol k8s) (hexol terraform) (hexol ansible)
                                       (hexol sql) (hexol ledger)))))
      (match rest
        (() (print-construct-index))
        ((name)
         (when (string-prefix? "-" name) (usage-error "doc: unknown flag ~a" name))
         (let ((found (find-constructs (string->symbol name))))
           (when (null? found) (die "doc: no construct named ~a (`hexol doc' lists them)" name))
           (for-each (lambda (s) (print-construct-doc s) (newline)) found)))
        (_ (usage-error "doc: want a single CONSTRUCT (inventory is -i/--inventory)"))))))

;; ---------------------------------------------------------------------------
;; secret — manage the inline (secrets-store …) in an inventory
;; ---------------------------------------------------------------------------
;;
;; Inventory is -i/--inventory (or $HEXOL_INVENTORY), never a positional — so a
;; secret verb's positionals are purely its domain tokens (KEY, VALUE). The
;; mutating verbs rewrite only the store form's span in place; plaintext reaches
;; only stdout (`get`) or $EDITOR (`edit`), never the file or a log.

(define secret-usage "\
usage:
  hexol secret ls               [-i INVENTORY]
  hexol secret get  KEY         [-i INVENTORY]
  hexol secret set  KEY [VALUE] [-i INVENTORY]   (VALUE omitted → read stdin)
  hexol secret edit KEY         [-i INVENTORY]   (one value, $EDITOR round-trip)
  hexol secret edit             [-i INVENTORY]   (whole store as an editable alist)
  hexol secret rm   KEY         [-i INVENTORY]
  hexol secret rekey            [-i INVENTORY]
  hexol secret init             [-i INVENTORY]

The inventory comes from -i/--inventory or $HEXOL_INVENTORY.")

(define (secret-error fmt . args)
  (format (current-error-port) "~a~%" (e-red (apply format #f fmt args)))
  (format (current-error-port) "~a~%" (e-dim secret-usage))
  (exit 2))

(define (cmd-secret args)
  (match args
    (() (display secret-usage) (newline) (exit 0))
    (((or "-h" "--help") . _) (display secret-usage) (newline) (exit 0))
    ((verb . rest)
     (call-with-values (lambda () (extract-inventory (string-append "secret " verb) rest))
       (lambda (inv vrest)
         (let* ((pos (filter (lambda (a) (not (string-prefix? "-" a))) vrest))
                (sym string->symbol)
                (cached #f)
                ;; Resolve the inventory (or secret-error, so the secret usage
                ;; block is shown), then prime its env once — running the
                ;; inventory's own key hook before secret-tool shells out to
                ;; sops. Memoized so it loads at most once per command.
                (inv* (lambda ()
                        (or cached
                            (let ((p (or inv (env-inventory)
                                         (secret-error "secret ~a: no inventory — pass -i FILE or set $HEXOL_INVENTORY"
                                                       verb))))
                              (prime-inventory-env p)
                              (set! cached p)
                              p)))))
           (match (cons verb pos)
             (("ls")            (secret-ls (inv*)))
             (("get" key)       (secret-get (inv*) (sym key)))
             (("set" key value) (secret-set (inv*) (sym key) value))
             (("set" key)       (secret-set (inv*) (sym key) #f))   ; value from stdin
             (("edit" key)      (secret-edit (inv*) (sym key)))     ; one value
             (("edit")          (secret-edit-all (inv*)))           ; whole store
             (("rm" key)        (secret-rm (inv*) (sym key)))
             (("rekey")         (secret-rekey (inv*)))
             (("init")          (secret-init (inv*)))
             ((v . _)
              (if (member v '("ls" "get" "set" "edit" "rm" "rekey" "init"))
                  (secret-error "secret ~a: wrong arguments — see usage" v)
                  (secret-error "secret: unknown verb ~a" v))))))))))

;; ---------------------------------------------------------------------------
;; import — existing manifests -> an inventory file (stdout)
;; ---------------------------------------------------------------------------
;;
;;   hexol import -f FILE|- [--from yaml|terraform] [--sugar] [--no-clean]
;;
;; The migration on-ramp: wrap what you have, refactor later. Takes no
;; inventory — it *produces* one. --from defaults by extension (`.json` →
;; terraform, else yaml). YAML: one op per document, `resource` by default,
;; --sugar lifts exact fits to the typed constructs, --no-clean keeps the
;; server-populated fields of a `kubectl get` dump. Terraform: JSON config
;; only — HCL text is out of scope.

(define import-usage "\
usage:
  hexol import -f FILE|-  [--from yaml|terraform] [--sugar] [--no-clean]

  -f FILE|-        the manifests to wrap (- reads stdin)
  --from FMT       yaml (k8s manifest stream) or terraform (JSON config,
                   *.tf.json — HCL text is NOT parsed); default by extension
  --sugar          lift Namespace/ConfigMap/Secret/Service/Deployment to the
                   typed (hexol k8s) constructs when they fit exactly
  --no-clean       keep status/managedFields/uid/resourceVersion/… (default: strip)

Writes the inventory to stdout:  hexol import -f app.yaml > app.scm")

(define (cmd-import args)
  (let loop ((args args) (file #f) (from #f) (sugar? #f) (clean? #t))
    (match args
      (() (do-import file from sugar? clean?))
      (((or "-f" "--file") f . rest) (loop rest f from sugar? clean?))
      (("--from" f . rest)           (loop rest file f sugar? clean?))
      (("--sugar" . rest)            (loop rest file from #t clean?))
      (("--clean" . rest)            (loop rest file from sugar? #t))
      (("--no-clean" . rest)         (loop rest file from sugar? #f))
      ((arg . rest)
       (cond
         ((string-prefix? "--file=" arg) (loop rest (flag-value "--file=" arg) from sugar? clean?))
         ((string-prefix? "--from=" arg) (loop rest file (flag-value "--from=" arg) sugar? clean?))
         (else (format (current-error-port) "~a~%~a~%"
                       (e-red (format #f "import: unexpected argument ~a" arg))
                       (e-dim import-usage))
               (exit 2)))))))

(define (do-import file from sugar? clean?)
  (unless file
    (format (current-error-port) "~a~%~a~%" (e-red "import: missing -f FILE") (e-dim import-usage))
    (exit 2))
  (when (string-suffix? ".tf" file)
    (die "import: ~a looks like HCL — only Terraform JSON config (*.tf.json) is parsed" file))
  (let* ((stdin? (string=? file "-"))
         (from   (or from (if (string-suffix? ".json" file) "terraform" "yaml")))
         (text   (cond (stdin? (get-string-all (current-input-port)))
                       ((file-exists? file) (call-with-input-file file get-string-all))
                       (else (die "import: no such file: ~a" file))))
         (source (if stdin? "stdin" file)))
    (cond
      ((string=? from "yaml")
       (display (import-yaml text #:sugar? sugar? #:clean? clean? #:source source)))
      ((string=? from "terraform")
       (display (import-terraform-json text #:source source)))
      (else (die "import: unknown --from ~s (want yaml | terraform)" from)))))

;; ---------------------------------------------------------------------------
;; verbs — the dispatch registry
;; ---------------------------------------------------------------------------
;;
;; A subcommand isn't a hardcoded arm of `dispatch`. It's a <verb>: a NAME, a
;; PREDICATE over the invocation — (subcommand full-args) -> bool — and a RUNNER
;; over the full post-program args (verb included). `dispatch` walks *verbs* and
;; runs the first whose predicate fires, so a new verb is one `register-verb!`
;; away with nothing in the dispatcher to touch.
;;
;; The predicate sees the full args, not just the verb, so a future verb can
;; fire on a flag or inventory shape rather than an exact name; the runner gets
;; every arg and slices what it needs. The built-ins just match their own name
;; (`cmd-is`) and delegate to their cmd-* handler. `help` stays OUT of this set
;; — it lists the verbs off *verbs* and must work before any inventory loads,
;; so it lives in the dispatch frame.
;;
;; *verbs* holds the BUILT-IN verbs (fixed at load). An inventory can also
;; contribute verbs: `defines-action NAME PROC` (sugar: `actions`) registers a
;; (state args -> effects) proc as a kernel <action>; when `dispatch` finds no
;; built-in match it loads the inventory collecting these and runs the one named
;; SUBCMD. Built-ins are tried first, so an inventory can only ADD verbs, never
;; shadow a core one — e.g. examples/homelab.scm's `destroy`.

;; A dispatchable CLI verb: NAME, PREDICATE over the invocation, RUNNER, and a
;; one-line SYNOPSIS for `--help'. Built-ins are <verb> records directly; an
;; inventory-contributed action (a kernel <action>) is adapted into one (see
;; `inventory-verbs'), so dispatch and help iterate one record type.
(define-record-type <verb>
  (make-verb name predicate runner synopsis)
  verb?
  (name      verb-name)
  (predicate verb-predicate)   ; (subcommand full-args) -> bool
  (runner    verb-runner)      ; (full-args) -> effects  (full-args includes the verb)
  (synopsis  verb-synopsis))   ; one-line usage shown in `hexol --help`

(define *verbs* '())

(define (register-verb! v)
  (set! *verbs* (append *verbs* (list v))))

;; Common predicate: fire when the leading subcommand is exactly NAME.
(define (cmd-is name)
  (lambda (subcmd args) (and subcmd (string=? subcmd name))))

;; cmd-* handlers want the args *after* the verb; the runner gets the full
;; list, so drop the head.
(define (delegating-runner cmd) (lambda (args) (cmd (cdr args))))

(register-verb!
 (make-verb "render" (cmd-is "render") (delegating-runner cmd-render)
   "render [-o sexp|json|yaml|terraform|ansible] [--path a.b.c] [--validate] [-i INVENTORY]"))
(register-verb!
 (make-verb "apply" (cmd-is "apply") (delegating-runner cmd-apply)
   "apply  [--only SPEC] [--dry-run] [--list] [-i INVENTORY]"))
(register-verb!
 (make-verb "diff" (cmd-is "diff") (delegating-runner cmd-diff)
   "diff   [--only SPEC] [--explain] [-i INVENTORY]   (exit 0 clean, 1 drift, 2 error)"))
(register-verb!
 (make-verb "tree" (cmd-is "tree") (delegating-runner cmd-tree)
   "tree    [-v] [-i INVENTORY]"))
(register-verb!
 (make-verb "explain" (cmd-is "explain") (delegating-runner cmd-explain)
   "explain PATH|HASH [-i INVENTORY]"))
(register-verb!
 (make-verb "lint" (cmd-is "lint") (delegating-runner cmd-lint)
   "lint    [-i INVENTORY]"))
(register-verb!
 (make-verb "show" (cmd-is "show") (delegating-runner cmd-show)
   "show    HASH [-i INVENTORY]"))
(register-verb!
 (make-verb "doc" (cmd-is "doc") (delegating-runner cmd-doc)
   "doc     [CONSTRUCT] [-i INVENTORY]"))
(register-verb!
 (make-verb "secret" (cmd-is "secret") (delegating-runner cmd-secret)
   "secret  <ls|get|set|edit|rm|rekey|init> … [-i INVENTORY]"))
(register-verb!
 (make-verb "import" (cmd-is "import") (delegating-runner cmd-import)
   "import  -f FILE|- [--from yaml|terraform] [--sugar] [--no-clean]   (→ inventory on stdout)"))

;; "|"-joined verb list for terse usage lines.
(define (verb-list) (string-join (map verb-name *verbs*) "|"))

;; ---------------------------------------------------------------------------
;; dispatch — the frame: help, then run the first matching action
;; ---------------------------------------------------------------------------

;; Inventory is invariant across a session, so it's NOT a positional on any
;; verb: pass -i/--inventory (or --inventory=FILE), or set $HEXOL_INVENTORY
;; once. That leaves each verb's positionals carrying only the domain token you
;; iterate on (PATH/HASH/KEY) — no trailing inventory to cursor past, no
;; KEY-vs-INVENTORY ambiguity.

;; $HEXOL_INVENTORY if non-empty, else #f. The shared fallback when
;; -i/--inventory is omitted.
(define (env-inventory)
  (and=> (getenv "HEXOL_INVENTORY")
         (lambda (v) (and (not (string-null? v)) v))))

(define (inventory-or-default cmd inv)
  (or inv (env-inventory)
      (usage-error "~a: no inventory — pass -i/--inventory FILE or set $HEXOL_INVENTORY" cmd)))

;; Pull -i/--inventory FILE (and --inventory=FILE) out of ARGS wherever it
;; appears; return (values INV REST): INV the file or #f, REST without the flag
;; and value, so each command parses only its own flags/positionals. CMD names
;; the verb for error messages.
(define (extract-inventory cmd args)
  (let loop ((args args) (inv #f) (acc '()))
    (match args
      (() (values inv (reverse acc)))
      (((or "-i" "--inventory")) (usage-error "~a: missing FILE after ~a" cmd (car args)))
      (((or "-i" "--inventory") f . rest) (loop rest f acc))
      ((arg . rest)
       (if (string-prefix? "--inventory=" arg)
           (loop rest (substring arg 12) acc)
           (loop rest inv (cons arg acc)))))))

;; Pull -v/--verbose out of ARGS wherever it appears, returning (values
;; VERBOSE? REST) so a verb can opt in without `inventory-only` (which rejects
;; stray args) tripping over the flag.
(define (extract-verbose args)
  (let loop ((args args) (v #f) (acc '()))
    (match args
      (() (values v (reverse acc)))
      (((or "-v" "--verbose") . rest) (loop rest #t acc))
      ((arg . rest) (loop rest v (cons arg acc))))))

;; For verbs whose only input is the inventory (tree, ops): resolve from
;; -i/--inventory or $HEXOL_INVENTORY and reject any stray argument.
(define (inventory-only cmd args)
  (call-with-values (lambda () (extract-inventory cmd args))
    (lambda (inv rest)
      (unless (null? rest)
        (usage-error "~a: unexpected argument ~a (this verb takes only -i/--inventory)"
                     cmd (car rest)))
      (inventory-or-default cmd inv))))

;; The prose tail of `hexol --help`; the verb synopses above it are generated
;; from *actions*, so the help can't drift from the registered set. Kept terse
;; on purpose — `--help` is mostly used to list verbs/inventory actions, so the
;; footer is just the cross-cutting notes that don't fit a synopsis line.
(define usage-footer "\
Inventory: -i/--inventory FILE, or set $HEXOL_INVENTORY (never a positional).
Global: --color[=always|never|auto] forces the human views' coloring.")

;; Adapt a kernel <action> — an inventory-contributed (state args -> effects)
;; verb — into a dispatch <verb>, so built-ins and inventory verbs share one
;; type and the one `(verb-runner v) args` path. The predicate fires on the
;; action's name; the runner strips -i off the post-verb args, resolves OPS
;; once, and calls the proc with the rest. OPS is shared from `inventory-verbs`
;; so the runner needn't reload.
(define (action->verb ops a)
  (make-verb
    (action-name a)
    (cmd-is (action-name a))
    (lambda (args)
      ;; ARGS leads with the verb; drop it so the action sees only its own
      ;; flags/positionals, like the cmd-* handlers' `(cdr args)`.
      (call-with-values (lambda () (extract-inventory (action-name a) (cdr args)))
        (lambda (_inv rest)
          ((action-proc a) (resolve ops '()) rest))))
    (or (action-synopsis a) (action-name a))))

;; The verbs INV contributes via `defines-action`, each adapted into a dispatch
;; <verb> (see action->verb) over the ops loaded once here. Errors propagate —
;; a broken inventory on a real verb should fail loudly; the help path catches.
(define (inventory-verbs inv)
  (call-with-values (lambda () (load-ops+collected current-actions inv))
    (lambda (ops actions)
      (map (lambda (a) (action->verb ops a)) actions))))

;; Like `inventory-verbs', but best-effort: '() when INV is unresolvable or
;; fails to load, so a broken inventory never breaks `--help'.
(define (inventory-verbs-safe inv)
  (if (and inv (file-exists? inv))
      (catch #t (lambda () (inventory-verbs inv)) (lambda _ '()))
      '()))

(define (show-help inv)
  (display "hexol — resolve a hexol inventory and view it.\n\nusage:\n")
  (for-each (lambda (v) (format #t "  hexol ~a~%" (verb-synopsis v))) *verbs*)
  ;; Inventory-contributed verbs, when an inventory is resolvable (this
  ;; invocation's -i/--inventory, else $HEXOL_INVENTORY). Under their own
  ;; heading so they read as the inventory's, not hexol's.
  (let ((custom (inventory-verbs-safe inv)))
    (unless (null? custom)
      (format #t "~%inventory actions (~a):~%" inv)
      (for-each (lambda (v) (format #t "  hexol ~a~%" (verb-synopsis v))) custom)))
  (newline)
  (display usage-footer)
  (newline))

;; The WHEN of `--color=WHEN`, validated. Bare `--color` is handled by the
;; caller as `always`.
(define (parse-color-when s)
  (cond
    ((string=? s "always") 'always)
    ((string=? s "never")  'never)
    ((string=? s "auto")   'auto)
    (else (usage-error "bad --color value ~s (want always|never|auto)" s))))

;; Pull the global `--color`/`--color=WHEN` flag out of ARGS wherever it appears;
;; return (values MODE REST): MODE the color mode (or #f when absent, so default
;; `auto' stands), REST without the flag. Global, not per-verb — it governs
;; every view's painting — so it's stripped before dispatch picks the verb.
(define (extract-color args)
  (let loop ((args args) (mode #f) (acc '()))
    (match args
      (() (values mode (reverse acc)))
      (("--color" . rest) (loop rest 'always acc))   ; bare → always
      ((arg . rest)
       (if (string-prefix? "--color=" arg)
           (loop rest (parse-color-when (substring arg 8)) acc)
           (loop rest mode (cons arg acc)))))))

;; Best-effort: the inventory this invocation will resolve (-i/--inventory or
;; $HEXOL_INVENTORY), or #f. A peek, not a consume — the verb still parses -i
;; itself; this just lets `dispatch` open the render cache once around every
;; verb, without threading it through each resolve site.
(define (peek-inventory args)
  (let loop ((args args))
    (match args
      (() (env-inventory))
      (((or "-i" "--inventory") f . _) f)
      ((arg . rest)
       (if (string-prefix? "--inventory=" arg) (substring arg 12) (loop rest))))))

;; A help request? `-h`/`--help` anywhere (often trailing `-i FILE`, e.g.
;; `hexol --help -i homelab.scm`), or a leading `help` verb. Loose on purpose:
;; help wins over dispatch, so a user can always see an inventory's actions.
(define (wants-help? args)
  (match args
    (("help" . _) #t)
    (_ (or (member "-h" args) (member "--help" args) #f))))

(define (dispatch args)
  (call-with-values (lambda () (extract-color (cdr args)))
   (lambda (mode rest)
    (when mode (set-color-mode! mode))
    ;; Version is frame-level like help: no inventory, no verb lookup.
    (when (or (member "--version" rest) (equal? rest '("version")))
      (format #t "hexol ~a~%" %hexol-version)
      (exit 0))
    ;; One render cache per invocation, scoped to this inventory's content, so
    ;; helm-template / remote-manifest shell-outs are reused across runs. #f (no
    ;; inventory, or an unusable cache dir) disables it — results are identical.
    (let ((inv (peek-inventory rest)))
      (parameterize ((current-render-cache
                      (and inv (file-exists? inv) (open-render-cache inv))))
        (match rest
          (() (show-help inv) (exit 0))
          ;; A help request shows help for INV (so `hexol --help -i FILE` and
          ;; `hexol -i FILE help` both list that inventory's actions, not just
          ;; the $HEXOL_INVENTORY one).
          ((? wants-help?) (show-help inv) (exit 0))
          ((subcmd . _)
           ;; Built-ins first, then INV's contributed verbs — both <verb>
           ;; records on the same `(verb-runner v) rest` path, so an inventory
           ;; can ADD verbs but never shadow a built-in. With no resolvable
           ;; inventory, the unknown-subcommand usage error stands.
           (let ((v (or (find (lambda (v) ((verb-predicate v) subcmd rest)) *verbs*)
                        (and inv
                             (find (lambda (v) ((verb-predicate v) subcmd rest))
                                   (inventory-verbs inv))))))
             (if v
                 ((verb-runner v) rest)
                 (usage-error "unknown subcommand: ~a" subcmd))))))))))

;; Turn a raised error into one clean stderr line, not a Guile backtrace — the
;; common case being a typo or mistake in the inventory being edited. Most Guile
;; errors arrive as (subr message message-args . _); we print the filled-in
;; message. HEXOL_DEBUG=1 bypasses this for the full backtrace.
(define (report-error key args)
  (match args
    ;; Standard (scm-error) shape: (subr message message-args . _), subr may be
    ;; #f. Fill the ~S/~A holes in the message.
    ((subr (? string? msg) margs . _)
     (format (current-error-port) "~a" (e-red "hexol: "))
     (when subr (format (current-error-port) "~a" (e-red (format #f "~a: " subr))))
     (format (current-error-port) "~a~%"
             (e-red (apply format #f msg (or margs '())))))
    (_ (format (current-error-port) "~a~%"
               (e-red (format #f "hexol: ~a: ~s" key args))))))

(define (main args)
  (if (getenv "HEXOL_DEBUG")
      (dispatch args)
      (catch #t
        (lambda () (dispatch args))
        ;; `exit` (from die/usage-error) raises 'quit — let it through with its
        ;; own status; everything else is unexpected.
        (lambda (key . rest)
          (if (eq? key 'quit)
              (apply exit rest)
              (begin (report-error key rest) (exit 1)))))))
