{
  "terraform": {
    "required_version": ">= 1.3.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      },
      "openstack": {
        "source": "terraform-provider-openstack/openstack",
        "version": "~> 3.0.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "eu-west-3"
    },
    "openstack": {
      "auth_url": "https://auth.cloud.example.com/v3",
      "domain_name": "Default",
      "region": "DELTA5"
    }
  },
  "resource": {
    "aws_security_group": {
      "api-db-sg": {
        "description": "RDS api-db ingress from VPC",
        "ingress": {
          "from_port": 5432,
          "to_port": 5432,
          "protocol": "tcp",
          "cidr_blocks": [
            "10.0.0.0/8"
          ]
        }
      }
    },
    "aws_db_instance": {
      "api-db": {
        "engine": "postgres",
        "engine_version": "15",
        "instance_class": "db.t3.medium",
        "allocated_storage": 20,
        "username": "app",
        "multi_az": false,
        "skip_final_snapshot": true,
        "vpc_security_group_ids": [
          "${aws_security_group.api-db-sg.id}"
        ]
      }
    },
    "aws_lb": {
      "frontend-lb": {
        "load_balancer_type": "network",
        "internal": false,
        "subnets": [
          "subnet-aaa",
          "subnet-bbb",
          "subnet-ccc"
        ]
      }
    },
    "aws_lb_target_group": {
      "frontend-lb": {
        "port": 443,
        "protocol": "TCP",
        "vpc_id": "vpc-main",
        "health_check": {
          "protocol": "TCP",
          "port": "443"
        }
      }
    },
    "aws_lb_listener": {
      "frontend-lb": {
        "load_balancer_arn": "${aws_lb.frontend-lb.arn}",
        "port": 443,
        "protocol": "TCP",
        "default_action": {
          "type": "forward",
          "target_group_arn": "${aws_lb_target_group.frontend-lb.arn}"
        }
      }
    },
    "openstack_compute_keypair_v2": {
      "deployer": {
        "name": "hexol-deployer",
        "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFbpd2C2lOnj0hDOaR0/vVEQzEb2CgTSCXi//2g6ilG9 polyedre@heimdall"
      }
    },
    "openstack_networking_network_v2": {
      "internal": {
        "name": "hexol-internal",
        "admin_state_up": true
      }
    },
    "openstack_networking_subnet_v2": {
      "internal": {
        "name": "hexol-internal",
        "network_id": "${openstack_networking_network_v2.internal.id}",
        "cidr": "192.168.42.0/24",
        "ip_version": 4
      }
    },
    "openstack_networking_secgroup_v2": {
      "web": {
        "name": "hexol-web",
        "description": "hexol web tier"
      }
    },
    "openstack_networking_secgroup_rule_v2": {
      "web-http": {
        "direction": "ingress",
        "ethertype": "IPv4",
        "protocol": "tcp",
        "port_range_min": 80,
        "port_range_max": 80,
        "remote_ip_prefix": "0.0.0.0/0",
        "security_group_id": "${openstack_networking_secgroup_v2.web.id}"
      }
    },
    "openstack_compute_instance_v2": {
      "app-1": {
        "name": "app-1",
        "image_name": "Debian 12",
        "flavor_name": "m1.small",
        "key_pair": "${openstack_compute_keypair_v2.deployer.name}",
        "user_data": "#cloud-config\nhostname: app-1\npackage_update: true\npackages: [nginx]\n",
        "security_groups": [
          "${openstack_networking_secgroup_v2.web.name}"
        ],
        "network": {
          "uuid": "${openstack_networking_network_v2.internal.id}",
          "fixed_ip_v4": "192.168.42.10"
        },
        "metadata": {
          "managed_by": "hexol",
          "environment": "dev",
          "fleet_size": "2"
        }
      },
      "app-2": {
        "name": "app-2",
        "image_name": "Debian 12",
        "flavor_name": "m1.small",
        "key_pair": "${openstack_compute_keypair_v2.deployer.name}",
        "user_data": "#cloud-config\nhostname: app-2\npackage_update: true\npackages: [nginx]\n",
        "security_groups": [
          "${openstack_networking_secgroup_v2.web.name}"
        ],
        "network": {
          "uuid": "${openstack_networking_network_v2.internal.id}",
          "fixed_ip_v4": "192.168.42.11"
        },
        "metadata": {
          "managed_by": "hexol",
          "environment": "dev",
          "fleet_size": "2"
        }
      }
    }
  }
}
